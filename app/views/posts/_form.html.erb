<%= form_with model: @post, html: { multipart: true } do |f| %>
  <% if @post.errors.any? %>
    <div id="error_explanation" class="alert alert-danger" role="alert">
      <h2><%= pluralize(@post.errors.count, "error") %> <%= t(:prohibited_save) %>:</h2>
      <ul>
        <% @post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.label :subject, class: "form-label" %>
        <%= f.select :subject, [["Suppliers"], ["Products"], ["Customers"], ["Marketing"], ["R&D"], ["Sales"], ["Others"]], {}, class: "form-select" %>
      </div>
      <div class="mb-3">
        <%= f.label :internal_url, class: "form-label" %>
        <%= f.text_field :internal_url, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.text_area :content, rows: 30, class: "form-control font-monospace" %>
      </div>

      <div class="mb-3">
        <%= f.label "Add attachments", class: "form-label" %>
        <%= file_field_tag "documents", type: :file, multiple: true, class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="form-actions mt-3">
    <%= f.submit nil, class: "btn btn-primary" %>
    <%= link_to t("helpers.links.cancel", default: t("helpers.links.cancel")), posts_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
