<h3>Select Your Customer Order</h3>
<p>Select customer to add new orders</p>
<hr class="gray">

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Address</th>
      <th>Since</th>
      <th>Balance</th>
      <th>Contact</th>
      <th>Telephone</th>
      <th>Select</th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.name %></td>
        <td><%= customer.address %></td>
        <td><%= customer.since %></td>
        <td><%= customer.balance %></td>
        <td><%= customer.contact %></td>
        <td><%= customer.telephone %></td>
        <td><%= link_to "Select", { controller: "orders", action: "new", customer_id: customer.id } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
