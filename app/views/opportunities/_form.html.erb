<%= form_with model: @opportunity, html: { class: "form-horizontal" } do |f| %>
  <% if @opportunity.errors.any? %>
    <div id="error_explanation" class="alert alert-danger" role="alert">
      <h2><%= pluralize(@opportunity.errors.count, "error") %> <%= t(:prohibited_save) %>:</h2>
      <ul>
        <% @opportunity.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :priority, class: "form-label" %>
    <%= f.text_field :priority, class: "form-control", placeholder: "[1WT]1-03, [2DT]1-02 .." %>
  </div>
  <div class="mb-3">
    <%= f.label "project_type(markets)", class: "form-label" %>
    <%= f.text_field :project_type, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :solution, class: "form-label" %>
    <%= f.text_field :solution, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :note, class: "form-label" %>
    <%= f.text_field :note, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :customer_id, class: "form-label" %>
    <%= f.select :customer_id, options_from_collection_for_select(Customer.all, :id, :name, @opportunity.customer_id), {}, class: "form-select" %>
  </div>

  <div class="form-actions">
    <%= f.submit nil, class: "btn btn-primary" %>
    <%= link_to t("helpers.links.cancel", default: t("helpers.links.cancel")), opportunities_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
