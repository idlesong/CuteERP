<%= form_with model: @sales_order, html: { class: "card" } do |f| %>
  <% if @sales_order.errors.any? %>
    <div class="alert alert-danger">
      <ul><% @sales_order.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul>
    </div>
  <% end %>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <%= f.label :end_customer_id, t(:end_customer), class: "form-label" %>
        <%= f.select :end_customer_id,
                     options_from_collection_for_select(Customer.order(:name), :id, :name, @sales_order.end_customer_id),
                     { include_blank: true }, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <%= f.label :payment_term, t(:payment_term), class: "form-label" %>
        <%= f.select :payment_term, Order::PAYMENT_TYPES, { include_blank: true }, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <%= f.label :required_date, t(:required_date), class: "form-label" %>
        <%= f.date_field :required_date, class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= f.label :remark, t(:remark), class: "form-label" %>
        <%= f.text_field :remark, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :bill_contact, "账单联系人", class: "form-label" %>
        <%= f.text_field :bill_contact, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :bill_address, "账单地址", class: "form-label" %>
        <%= f.text_field :bill_address, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :bill_telephone, "账单电话", class: "form-label" %>
        <%= f.text_field :bill_telephone, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :ship_contact, "收货联系人", class: "form-label" %>
        <%= f.text_field :ship_contact, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :ship_address, "收货地址", class: "form-label" %>
        <%= f.text_field :ship_address, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :ship_telephone, "收货电话", class: "form-label" %>
        <%= f.text_field :ship_telephone, class: "form-control" %>
      </div>
    </div>
  </div>
  <div class="card-footer text-center">
    <%= link_to "取消", @sales_order, class: "btn btn-outline-secondary" %>
    <%= f.submit "保存", class: "btn btn-primary" %>
  </div>
<% end %>
