<div class="page-header d-flex justify-content-between">
  <h1><%= t(:sales_order) %> <%= @sales_order.serial_number %></h1>
  <div>
    <%= link_to "生产编排", edit_production_sales_order_path(@sales_order), class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "出库", confirm_sales_order_path(@sales_order), class: "btn btn-primary btn-sm" %>
  </div>
</div>

<% if notice %><p class="alert alert-info"><%= notice %></p><% end %>
<% if alert %><p class="alert alert-warning"><%= alert %></p><% end %>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm mb-0">
      <tr>
        <td><%= t(:customer) %>: <%= link_to @sales_order.customer.name, @sales_order.customer %></td>
        <td><%= t(:end_customer) %>: <%= @sales_order.end_customer&.name || "—" %></td>
        <td><%= t(:payment_term) %>: <%= @sales_order.payment_term %></td>
      </tr>
      <tr>
        <td><%= t(:required_date) %>: <%= @sales_order.required_date&.to_date || "—" %></td>
        <td>
          <%= t(:ship_date) %>:
          <% if @sales_order.shipped? %>
            <span class="badge bg-success"><%= @sales_order.delivery_date.to_date %>（末次出库）</span>
          <% else %>
            <span class="badge bg-secondary">未出库</span>
          <% end %>
        </td>
        <td>
          <%= t(:currency) %>: <%= @sales_order.customer.currency %>
          <% unless @sales_order.exchange_rate == 1 %>（汇率 <%= @sales_order.exchange_rate %>）<% end %>
        </td>
      </tr>
      <tr>
        <td><%= t(:contact) %>: <%= @sales_order.bill_contact %> / <%= @sales_order.bill_telephone %></td>
        <td><%= t(:address) %>: <%= @sales_order.bill_address %></td>
        <td><%= t(:remark) %>: <%= @sales_order.remark %></td>
      </tr>
    </table>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header"><h5><%= t(:order_details) %></h5></div>
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>#</th>
          <th><%= t(:product_name) %></th>
          <th><%= t(:part_number) %></th>
          <th><%= t(:quantity) %></th>
          <th>已出库</th>
          <th>来源客户订单</th>
          <th><%= t(:price) %></th>
          <th><%= t(:suble_total) %></th>
          <th>版本</th>
          <th><%= t(:remark) %></th>
        </tr>
      </thead>
      <tbody>
        <% currency_unit = @sales_order.customer.currency == "USD" ? "$" : "¥" %>
        <% @sales_order.production_lines.each_with_index do |line, i| %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= line.product_name %></td>
            <td><%= line.part_number %></td>
            <td>x<%= line.quantity %></td>
            <td><%= line.shipped_qty %></td>
            <td>
              <% line.order_lines.each do |ol| %>
                <%= link_to ol.display_no, order_path(ol.order) %>
                <% end %>
            </td>
            <td><%= number_to_currency(line.unit_price, unit: currency_unit) %></td>
            <td><%= number_to_currency(line.total_price, unit: currency_unit) %></td>
            <td><%= line.version %></td>
            <td><%= line.remark %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    合计：<%= number_to_currency(@sales_order.total_price, unit: currency_unit) %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header"><h5>出库单</h5></div>
  <div class="card-body">
    <% if @sales_order.shipments.any? %>
      <table class="table table-sm">
        <thead>
          <tr><th>#</th><th>出库时间</th><th>快递号</th><th>数量</th><th>备注</th><th></th></tr>
        </thead>
        <tbody>
          <% @sales_order.shipments.order(:shipped_at).each do |sh| %>
            <tr>
              <td><%= sh.id %></td>
              <td><%= sh.shipped_at.strftime("%F %H:%M") %></td>
              <td><%= sh.tracking_no %></td>
              <td><%= sh.shipment_lines.sum(:quantity) %></td>
              <td><%= sh.note %></td>
              <td><%= link_to "✘", shipment_path(sh), data: { turbo_method: :delete, turbo_confirm: "删除该出库单？" }, class: "btn btn-link text-danger" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span class="text-muted">暂无出库记录</span>
    <% end %>
  </div>
  <div class="card-footer">
    <%= link_to "返回列表", sales_orders_path, class: "btn btn-outline-secondary" %>
    <%= link_to "编辑单头", edit_sales_order_path(@sales_order), class: "btn btn-outline-secondary" %>
    <a href="<%= invoice_sales_order_path(@sales_order) %>.pdf" target="_blank" class="btn btn-outline-primary"><%= t(:invoice) %></a>
    <a href="<%= packing_list_sales_order_path(@sales_order) %>.pdf" target="_blank" class="btn btn-outline-primary"><%= t(:packing_list) %></a>
    <%= link_to "六联单", production_sales_order_path(@sales_order), class: "btn btn-outline-primary" %>
    <%= link_to "删除", sales_order_path(@sales_order), data: { turbo_method: :delete, turbo_confirm: "删除 #{@sales_order.serial_number}？" }, class: "btn btn-outline-danger" %>
  </div>
</div>
