<div class="row">
  <div class="card">
    <div class="card-body">
      <h2>
        <%= wicked_pdf_image_tag("sicomm_logo.jpg") %>无锡士康通讯技术有线公司
      </h2>
      <table class="table">
        <thead>
          <tr>
            <td>
              <h5>Wuxi Sicomm Communication Tech</h5>
              <h5>Address: B building #21 road, Wuxi</h5>
              <h5>Tel:051066682208 Fax: 051066682208</h5>
            </td>
            <td>
              <h4 class="text-right">Date: <%= @sales_order.created_at.to_date %></h4>
              <h4 class="text-right">PO#:PO<%= @sales_order.serial_number %></h4>
              <h4 class="text-right">Payment:<%= @sales_order.payment_term %></h4>
            </td>
          </tr>
        </thead>
        <tr><td colspan="2"><h3 class="text-center">Packing List</h3></td></tr>
        <tr>
          <td><h4>Bill to: <%= cust_name(@sales_order.customer) %></h4></td>
          <td><h4>Ship to: <%= cust_name(@sales_order.customer) %></h4></td>
        </tr>
        <tr><td>Contact:<%= @sales_order.bill_contact %></td><td>Contact:<%= @sales_order.ship_contact %></td></tr>
        <tr><td>Address:<%= @sales_order.bill_address %></td><td>Address:<%= @sales_order.ship_address %></td></tr>
        <tr><td>Tel: <%= @sales_order.bill_telephone %></td><td>Tel:<%= @sales_order.ship_telephone %></td></tr>
      </table>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h5>Order details</h5>
    <table class="table">
      <thead>
        <tr>
          <th><h4>#</h4></th>
          <th><h4>Product name</h4></th>
          <th><h4>PartNo.</h4></th>
          <th><h4>Qty</h4></th>
          <th><h4>Price</h4></th>
          <th><h4>Suble Total</h4></th>
        </tr>
      </thead>
      <tbody>
      <% currency_unit = @sales_order.customer.currency == "USD" ? "$" : "¥" %>
        <% @sales_order.production_lines.each_with_index do |line, line_index| %>
          <tr>
            <td><%= line_index + 1 %></td>
            <td><%= line.product_name %></td>
            <td><%= line.part_number %></td>
            <td><%= line.quantity %></td>
            <td><%= money(line.unit_price, @sales_order.customer.currency) %></td>
            <td><%= money(line.total_price, @sales_order.customer.currency) %></td>
          </tr>
<% end %>
      </tbody>
    </table>

    <div class="row text-end">
      <div class="col-md-2 offset-md-8">
        <p>
          <strong>
            TAX : <br>
            Total : <br>
          </strong>
        </p>
      </div>
      <div class="col-md-2">
        <strong>
          $1200.00 <br>
          N/A <br>
          $1200.00 <br>
        </strong>
      </div>
    </div>
    <hr>
    remarks:
    <hr>
  </div>
</div>
