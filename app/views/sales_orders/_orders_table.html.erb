<%# 六联单行级表格（列表页/工作台复用）
    locals: orders —— SalesOrder 集合（含 production_lines、customer）；
            show_tfoot —— 快速选客户行；paging —— false 关闭分页；
            quick_edit —— true 时显示行「编辑」与编辑行（数量/版本/约定发货日期，工作台用）；
            back —— workbench 时快捷出货与保存后回工作台 %>
<%# 选客户/行编辑表单置于表格外（本 partial 不再依赖父视图的包裹表单），行内控件以 form= 关联 %>
<% if local_assigns[:show_tfoot] %>
  <%= form_tag new_sales_order_path, method: :get, id: "so-new-form" do end %>
<% end %>
<% if local_assigns[:quick_edit] && params[:so_edit_id].present? %>
  <% edit_pl = ProductionLine.find_by(id: params[:so_edit_id].to_i) %>
  <% if edit_pl %>
    <%= form_tag update_production_sales_order_path(edit_pl.sales_order_id), method: :patch, id: "so-edit-form" do %>
      <input type="hidden" name="return_to" value="<%= local_assigns[:back] %>">
    <% end %>
  <% end %>
<% end %>
<table class="table table-striped table-sm datatable" <%= 'data-paging="off"'.html_safe unless local_assigns[:paging] %>>
  <thead>
    <tr>
      <th>六联单号</th>
      <th>下单日期</th>
      <th><%= t(:customer) %></th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:quantity) %></th>
      <th>含税单价</th>
      <th>版本</th>
      <th>约定发货日期</th>
      <th><%= local_assigns[:remaining] ? "剩余数量" : "已发数量" %></th>
      <th><%= t(:status) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% orders.each do |order| %>
      <% currency_unit = order.customer.currency == "USD" ? "$" : "¥" %>
      <% if order.production_lines.empty? %>
        <tr>
          <td><%= link_to order.serial_number, sales_order_path(order) %></td>
          <td><%= order.created_at.strftime("%F") %></td>
          <td><%= cust_name(order.customer) %></td>
          <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
          <td></td><td></td><td></td><td class="text-muted">无行（异常，请检查）</td>
        </tr>
      <% end %>
      <% order.production_lines.each do |line| %>
        <% if local_assigns[:quick_edit] && params[:so_edit_id].to_i == line.id %>
          <%# 行编辑行：数量/版本/约定发货日期可改（数量不得低于已出库，模型校验）；
              隐藏 item_id/full_name 随 lines[id] 提交，避免 update_production 置空；
              可编辑单元格放 visually-hidden 文本锚点保证列筛选可匹配 %>
          <tr class="table-warning">
            <td><%= link_to order.serial_number, sales_order_path(order) %></td>
            <td><%= order.created_at.strftime("%F") %></td>
            <td><%= cust_name(order.customer) %></td>
            <td><%= line.part_number %></td>
            <td><span class="visually-hidden"><%= line.quantity %></span>
                <input form="so-edit-form" type="hidden" name="lines[<%= line.id %>][item_id]" value="<%= line.item_id %>">
                <input form="so-edit-form" type="hidden" name="lines[<%= line.id %>][full_name]" value="<%= line.full_name %>">
                <input form="so-edit-form" name="lines[<%= line.id %>][quantity]" type="number" min="<%= line.shipped_qty %>" value="<%= line.quantity %>" class="form-control form-control-sm" style="width: 6rem;"></td>
            <td><%= money(line.unit_price, order.customer.currency) %></td>
            <td><span class="visually-hidden"><%= line.version %></span>
                <input form="so-edit-form" name="lines[<%= line.id %>][version]" value="<%= line.version %>" class="form-control form-control-sm" style="width: 6rem;"></td>
            <td><span class="visually-hidden"><%= order.required_date&.to_date %></span>
                <input form="so-edit-form" name="sales_order[required_date]" type="date" value="<%= order.required_date&.to_date %>" class="form-control form-control-sm"></td>
            <td><%= local_assigns[:remaining] ? line.unshipped_qty : line.shipped_qty %></td>
            <td>
              <% if order.draft? %>
                <span class="badge bg-secondary">草稿</span>
              <% else %>
                <span class="badge bg-success">已提交</span>
              <% end %>
            </td>
            <td class="text-nowrap">
              <button type="submit" form="so-edit-form" class="btn btn-sm btn-primary">保存</button>
              <%= link_to "取消", request.query_parameters.except("so_edit_id"), class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% else %>
        <tr>
          <td><%= link_to order.serial_number, sales_order_path(order) %></td>
          <td><%= order.created_at.strftime("%F") %></td>
          <td><%= cust_name(order.customer) %></td>
          <td><%= line.part_number %></td>
          <td class="text-end"><%= line.quantity %></td>
          <td><%= money(line.unit_price, order.customer.currency) %></td>
          <td><%= line.version %></td>
          <td><%= order.required_date&.to_date || "—" %></td>
          <td><%= local_assigns[:remaining] ? line.unshipped_qty : line.shipped_qty %></td>
          <td>
            <% if order.draft? %>
              <span class="badge bg-secondary">草稿</span>
            <% else %>
              <span class="badge bg-success">已提交</span>
            <% end %>
          </td>
          <%# 操作列：提交/快捷出货/出库 + quick_edit 时的行「编辑」链接 %>
          <% edit_link = if local_assigns[:quick_edit] && params[:so_edit_id].to_i != line.id
                           link_to("编辑", request.query_parameters.merge(so_edit_id: line.id), class: "btn btn-link btn-sm p-0 ps-2")
                         end %>
          <% if order.draft? %>
            <td><%= link_to "提交", submit_sales_order_path(order, return_to: local_assigns[:back]),
                            data: { turbo_method: :patch,
                                    turbo_confirm: "提交六联单 #{order.serial_number}（共 #{order.production_lines.size} 行）？" },
                            class: "text-primary" %><%= edit_link %></td>
          <% elsif line.unshipped_qty.positive? %>
            <% if local_assigns[:quick_ship] %>
              <td><button type="button" class="btn btn-link btn-sm text-primary p-0"
                          data-bs-toggle="modal" data-bs-target="#quickShipModal"
                          data-so-id="<%= order.id %>" data-serial="<%= order.serial_number %>"
                          data-customer="<%= cust_name(order.customer) %>"
                          data-lines="<%= order.production_lines.map { |l| "#{l.id}:#{l.part_number}:#{l.unshipped_qty}" }.join('|') %>">快捷出货</button><%= edit_link %></td>
            <% else %>
              <td><%= link_to "出库", confirm_sales_order_path(order) %><%= edit_link %></td>
            <% end %>
          <% else %>
            <td><span class="badge bg-success">已出完</span><%= edit_link %></td>
          <% end %>
        </tr>
        <% end %>
      <% end %>
    <% end %>
  </tbody>
  <% if local_assigns[:show_tfoot] %>
    <tfoot>
      <tr class="inline-new-row">
        <th></th>
        <th></th>
        <th>
          <%= select_tag :customer_id, options_from_collection_for_select(Customer.order(:name_zh, :name), :id, ->(c) { cust_name(c) }),
                         prompt: "客户*", form: "so-new-form", class: "form-select form-select-sm", style: "width: 12rem;", required: true, data: { searchable: true } %>
        </th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th><%= submit_tag "选客户开六联单", form: "so-new-form", class: "btn btn-sm btn-primary" %></th>
      </tr>
    </tfoot>
  <% end %>
</table>

<% if local_assigns[:quick_ship] %>
<div class="modal fade" id="quickShipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <%= form_tag "", method: :post, class: "modal-content", id: "quickShipForm" do %>
      <input type="hidden" name="return_to" value="workbench">
      <div class="modal-header">
        <h5 class="modal-title">快捷出货 <span id="qh_serial" class="text-primary"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">客户：<strong id="qh_customer"></strong></div>
        <div id="qh_line_rows"></div>
        <div class="mb-2">
          <label class="form-label">快递号</label>
          <input name="tracking_no" class="form-control form-control-sm">
        </div>
        <div class="small text-muted">各行的出库数量默认为剩余数量，可修改；0 表示该行不出。</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
        <%= submit_tag "出库", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", () => {
    const modal = document.getElementById("quickShipModal")
    if (!modal) return
    modal.addEventListener("show.bs.modal", (e) => {
      const d = e.relatedTarget.dataset
      modal.querySelector("#qh_serial").textContent = d.serial
      modal.querySelector("#qh_customer").textContent = d.customer
      const form = modal.querySelector("#quickShipForm")
      form.action = "/sales_orders/" + d.soId + "/create_shipment"
      const rows = modal.querySelector("#qh_line_rows")
      rows.innerHTML = ""
      d.lines.split("|").forEach((item) => {
        const [id, part, unshipped] = item.split(":")
        const row = document.createElement("div")
        row.className = "d-flex align-items-center gap-2 mb-1"
        row.innerHTML = `<span class="flex-grow-1">${part}</span>` +
          `<span class="text-muted small">剩 ${unshipped}</span>` +
          `<input name="lines[${id}][quantity]" type="number" min="0" max="${unshipped}" value="${unshipped}" class="form-control form-control-sm" style="width: 5.5rem;">`
        rows.appendChild(row)
      })
    })
  })
</script>
<% end %>
