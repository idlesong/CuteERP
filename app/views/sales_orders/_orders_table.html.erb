<%# 六联单行级表格（列表页/工作台复用）
    locals: orders —— SalesOrder 集合（含 production_lines、customer）；
            show_tfoot —— 列表页快速选客户行；paging —— false 关闭分页 %>
<table class="table table-striped datatable" <%= 'data-paging="off"'.html_safe unless local_assigns[:paging] %>>
  <thead>
    <tr>
      <th>六联单号</th>
      <th>下单日期</th>
      <th><%= t(:customer) %></th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:quantity) %></th>
      <th>含税单价</th>
      <th>版本</th>
      <th>约定发货日期</th>
      <th><%= local_assigns[:remaining] ? "剩余数量" : "已发数量" %></th>
      <th><%= t(:status) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% orders.each do |order| %>
      <% currency_unit = order.customer.currency == "USD" ? "$" : "¥" %>
      <% if order.production_lines.empty? %>
        <tr>
          <td><%= link_to order.serial_number, sales_order_path(order) %></td>
          <td><%= order.created_at.strftime("%F") %></td>
          <td><%= cust_name(order.customer) %></td>
          <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
          <td></td><td></td><td></td><td class="text-muted">无行（异常，请检查）</td>
        </tr>
      <% end %>
      <% order.production_lines.each do |line| %>
        <tr>
          <td><%= link_to order.serial_number, sales_order_path(order) %></td>
          <td><%= order.created_at.strftime("%F") %></td>
          <td><%= cust_name(order.customer) %></td>
          <td><%= line.part_number %></td>
          <td class="text-end"><%= line.quantity %></td>
          <td><%= money(line.unit_price, order.customer.currency) %></td>
          <td><%= line.version %></td>
          <td><%= order.required_date&.to_date || "—" %></td>
          <td><%= local_assigns[:remaining] ? line.unshipped_qty : line.shipped_qty %></td>
          <td>
            <% if order.draft? %>
              <span class="badge bg-secondary">草稿</span>
            <% else %>
              <span class="badge bg-success">已提交</span>
            <% end %>
          </td>
          <% if order.draft? %>
            <td><%= link_to "提交", submit_sales_order_path(order, return_to: local_assigns[:back]),
                            data: { turbo_method: :patch,
                                    turbo_confirm: "提交六联单 #{order.serial_number}（共 #{order.production_lines.size} 行）？" },
                            class: "text-primary" %></td>
          <% elsif local_assigns[:quick_ship] %>
            <td><button type="button" class="btn btn-link btn-sm text-primary p-0"
                        data-bs-toggle="modal" data-bs-target="#quickShipModal"
                        data-so-id="<%= order.id %>" data-serial="<%= order.serial_number %>"
                        data-customer="<%= cust_name(order.customer) %>"
                        data-lines="<%= order.production_lines.map { |l| "#{l.id}:#{l.part_number}:#{l.unshipped_qty}" }.join('|') %>">快捷出货</button></td>
          <% else %>
            <td><%= link_to "出库", confirm_sales_order_path(order) %></td>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </tbody>
  <% if local_assigns[:show_tfoot] %>
    <tfoot>
      <tr class="inline-new-row">
        <th></th>
        <th></th>
        <th>
          <%= select_tag :customer_id, options_from_collection_for_select(Customer.order(:name), :id, :name),
                         prompt: "客户*", class: "form-select form-select-sm", style: "width: 12rem;", required: true %>
        </th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
        <th><%= submit_tag "选客户开六联单", class: "btn btn-sm btn-primary" %></th>
      </tr>
    </tfoot>
  <% end %>
</table>

<% if local_assigns[:quick_ship] %>
<div class="modal fade" id="quickShipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <%= form_tag "", method: :post, class: "modal-content", id: "quickShipForm" do %>
      <input type="hidden" name="return_to" value="workbench">
      <div class="modal-header">
        <h5 class="modal-title">快捷出货 <span id="qh_serial" class="text-primary"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">客户：<strong id="qh_customer"></strong></div>
        <div id="qh_line_rows"></div>
        <div class="mb-2">
          <label class="form-label">快递号</label>
          <input name="tracking_no" class="form-control form-control-sm">
        </div>
        <div class="small text-muted">各行的出库数量默认为剩余数量，可修改；0 表示该行不出。</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
        <%= submit_tag "出库", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", () => {
    const modal = document.getElementById("quickShipModal")
    if (!modal) return
    modal.addEventListener("show.bs.modal", (e) => {
      const d = e.relatedTarget.dataset
      modal.querySelector("#qh_serial").textContent = d.serial
      modal.querySelector("#qh_customer").textContent = d.customer
      const form = modal.querySelector("#quickShipForm")
      form.action = "/sales_orders/" + d.soId + "/create_shipment"
      const rows = modal.querySelector("#qh_line_rows")
      rows.innerHTML = ""
      d.lines.split("|").forEach((item) => {
        const [id, part, unshipped] = item.split(":")
        const row = document.createElement("div")
        row.className = "d-flex align-items-center gap-2 mb-1"
        row.innerHTML = `<span class="flex-grow-1">${part}</span>` +
          `<span class="text-muted small">剩 ${unshipped}</span>` +
          `<input name="lines[${id}][quantity]" type="number" min="0" max="${unshipped}" value="${unshipped}" class="form-control form-control-sm" style="width: 5.5rem;">`
        rows.appendChild(row)
      })
    })
  })
</script>
<% end %>
