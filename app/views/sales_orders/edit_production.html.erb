<h1>生产编排 <%= @sales_order.serial_number %></h1>

<% if flash[:alert] %><p class="alert alert-warning"><%= flash[:alert] %></p><% end %>
<% if flash[:notice] %><p class="alert alert-info"><%= flash[:notice] %></p><% end %>

<%= content_for :doc_title, "生产编排" %>
<%= render "doc_header" %>

<%# 追加行：从未分配 PO 行池挑选（未出库即可加行） %>
<% pool = DemandQuery.allocatable_lines(customer_id: @sales_order.customer_id).reject { |l| l.allocatable_qty <= 0 } %>
<%= form_tag add_line_sales_order_path(@sales_order), class: "card mb-3" do %>
  <div class="card-body py-2">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small mb-0">追加行（选未签发完的订单行）</label>
        <select name="order_line_id" class="form-select form-select-sm" required>
          <option value="" selected disabled>订单行*</option>
          <% pool.each do |ol| %>
            <option value="<%= ol.id %>"><%= ol.display_no %>｜<%= ol.generic_part_no %>｜可分配 <%= ol.allocatable_qty %></option>
          <% end %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">数量</label>
        <input name="quantity" type="number" min="1" class="form-control form-control-sm" style="width: 6rem;" required>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">后缀</label>
        <input name="suffix" class="form-control form-control-sm" style="width: 5rem;" placeholder="如 C">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">版本</label>
        <input name="version" class="form-control form-control-sm" style="width: 6rem;">
      </div>
      <div class="col-auto">
        <%= submit_tag "追加行", class: "btn btn-sm btn-primary" %>
      </div>
    </div>
  </div>
<% end %>

<%= form_tag update_production_sales_order_path(@sales_order), method: :patch, class: "card" do %>
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>#</th>
          <th>通用型号</th>
          <th>正式型号（转产选后缀）</th>
          <th><%= t(:quantity) %></th>
          <th>已出库</th>
          <th>版本</th>
          <th><%= t(:uniform_number) %></th>
          <th><%= t(:remark) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sales_order.production_lines.each_with_index do |line, i| %>
          <% generic = line.item&.generic_part_no %>
          <% candidates = generic ? Item.where(generic_part_no: generic).order(:suffix) : Item.none %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= generic || "—" %><div class="small text-muted"><%= line.order_lines.map(&:display_no).join(", ") %></div></td>
            <td>
              <select name="lines[<%= line.id %>][item_id]" class="form-select form-select-sm">
                <% if candidates.any? %>
                  <%= options_for_select(candidates.map { |it| ["#{it.partNo}#{' ★' if it.id == line.item_id}", it.id] }, line.item_id) %>
                <% else %>
                  <option value=""><%= line.part_number || "未定型" %></option>
                <% end %>
              </select>
            </td>
            <td><input name="lines[<%= line.id %>][quantity]" type="number" min="<%= line.shipped_qty + 1 %>" value="<%= line.quantity %>"
                       class="form-control form-control-sm" style="width: 6rem;"></td>
            <td><%= line.shipped_qty %></td>
            <td><input name="lines[<%= line.id %>][version]" value="<%= line.version %>"
                       class="form-control form-control-sm" style="width: 6rem;"></td>
            <td><input name="lines[<%= line.id %>][full_name]" value="<%= line.full_name %>"
                       class="form-control form-control-sm" style="width: 12rem;"></td>
            <td><input name="lines[<%= line.id %>][remark]" value="<%= line.remark %>"
                       class="form-control form-control-sm" style="width: 12rem;"></td>
            <td>
              <% if line.shipped_qty.zero? %>
                <%= link_to "✘", remove_line_sales_order_path(@sales_order, line_id: line.id),
                            data: { turbo_method: :delete,
                                    turbo_confirm: "删除该行？其客户订单需求将释放回待签发池" },
                            class: "btn btn-link text-danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="small text-muted">未出库的行可随意改数量/型号/版本，或删除（需求自动释放回待签发池）；已出库行数量只能增不能减。</div>
  </div>
  <div class="card-footer text-center">
    <%= link_to "取消", production_sales_order_path(@sales_order), class: "btn btn-outline-secondary" %>
    <%= submit_tag "保存编排", class: "btn btn-primary" %>
  </div>
<% end %>
