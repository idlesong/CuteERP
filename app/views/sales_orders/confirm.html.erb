<h1>出库 <%= @sales_order.serial_number %></h1>

<% if flash[:alert] %><p class="alert alert-warning"><%= flash[:alert] %></p><% end %>

<%= content_for :doc_title, "出库单" %>
<%= render "doc_header" %>

<%= form_tag create_shipment_sales_order_path(@sales_order), class: "card" do %>
  <div class="card-body">
    <div class="row g-3 mb-3">
      <div class="col-md-3">
        <label class="form-label">出库时间</label>
        <input name="shipped_at" type="datetime-local" class="form-control"
               value="<%= Time.current.strftime("%Y-%m-%dT%H:%M") %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">快递号（仅存储）</label>
        <input name="tracking_no" class="form-control">
      </div>
      <div class="col-md-6">
        <label class="form-label">备注</label>
        <input name="note" class="form-control">
      </div>
    </div>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>#</th>
          <th><%= t(:part_number) %></th>
          <th>生产数量</th>
          <th>已出库</th>
          <th>本次出库数量</th>
        </tr>
      </thead>
      <tbody>
        <% @sales_order.production_lines.each_with_index do |line, i| %>
          <tr class="<%= 'table-light' if line.unshipped_qty <= 0 %>">
            <td><%= i + 1 %></td>
            <td><%= line.part_number %><span class="text-muted small"> <%= line.product_name %></span></td>
            <td><%= line.quantity %></td>
            <td><%= line.shipped_qty %></td>
            <td>
              <% if line.unshipped_qty.positive? %>
                <input name="lines[<%= line.id %>][quantity]" type="number" min="0" max="<%= line.unshipped_qty %>"
                       value="0" class="form-control form-control-sm" style="width: 6rem;">
              <% else %>
                <span class="text-muted">已出完</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer text-center">
    <%= link_to "取消", @sales_order, class: "btn btn-outline-secondary" %>
    <%= submit_tag "创建出库单", class: "btn btn-primary" %>
  </div>
<% end %>
