<h1>六联单</h1>

<%= content_for :doc_title, t(:sales_order) %>
<%= render "doc_header" %>

<div class="card">
  <div class="card-body">
    <h5><%= t(:order_details) %></h5>
    <table class="table">
      <thead>
        <tr>
          <th><h4>#</h4></th>
          <th><h4><%= t(:uniform_number) %></h4></th>
          <th><h4><%= t(:part_number) %></h4></th>
          <th><h4><%= t(:quantity) %></h4></th>
          <th><h4>版本</h4></th>
          <th><h4><%= t(:property) %>/<%= t(:remark) %></h4></th>
        </tr>
      </thead>
      <tbody>
        <% @sales_order.production_lines.each_with_index do |line, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= line.full_name %></td>
            <td><%= line.part_number %></td>
            <td><%= line.quantity %></td>
            <td><%= line.version %></td>
            <td><%= line.remark %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card-footer">
    | <%= link_to t(:produce_order), edit_production_sales_order_path(@sales_order) %>
    | <%= link_to t(:ship_now), confirm_sales_order_path(@sales_order) %>
    | <a href="<%= invoice_sales_order_path(@sales_order) %>.pdf" target="_blank"><%= t(:invoice) %></a>
    | <a href="<%= packing_list_sales_order_path(@sales_order) %>.pdf" target="_blank"><%= t(:packing_list) %></a>
  </div>
</div>

<%= render "packing_list" %>

<!-- Large modal Invoice-->
<div class="modal fade bs-invoice-modal-lg" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-body">
        <%= render "invoice" %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <a href="<%= invoice_sales_order_path(@sales_order) %>.pdf" class="btn btn-primary" target="_blank">Print Invoice</a>
      </div>
    </div>
  </div>
</div>
