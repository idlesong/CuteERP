<div class="page-header d-flex justify-content-between align-items-center">
  <h1>
    阶梯价目
    <% if @release %>
      <small>发布批次：<%= @release.released_at.strftime("%F") %><%= "（历史批次，只读）" unless @latest %></small></h1>
    <% end %>
  </h1>
  <%= form_tag price_lists_path, method: :get, class: "form-inline" do %>
    <%= select_tag :release_id, options_from_collection_for_select(@releases, :id, ->(r) { r.released_at.strftime("%F") }, @release&.id), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
  <% end %>
</div>

<% if @entries.any? %>
  <% if @latest %>
  <%= form_tag create_entry_price_lists_path do %>
  <table class="table table-striped datatable">
    <thead>
      <tr>
        <th>通用型号</th>
        <th colspan="<%= @tiers.size %>">OEM</th>
        <th colspan="<%= @tiers.size %>">ODM</th>
        <th><%= t(:actions) %></th>
      </tr>
      <tr>
        <th>数量档</th>
        <% PriceListEntry::TIER_LABELS.each do |lb| %><th><%= lb %></th><% end %>
        <% PriceListEntry::TIER_LABELS.each do |lb| %><th><%= lb %></th><% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @entries.group_by(&:generic_part_no).each do |gen, rows| %>
        <tr>
          <td><strong><%= gen %>*</strong></td>
          <% [ "OEM", "ODM" ].each do |channel| %>
            <% @tiers.each do |q| %>
              <% e = rows.find { |r| r.sell_by == channel && r.min_qty == q } %>
              <td class="text-end"><%= e ? money(e.price) : "-" %></td>
            <% end %>
          <% end %>
          <td><%= link_to "删除", destroy_generic_price_lists_path(generic_part_no: gen),
                          data: { turbo_method: :delete, turbo_confirm: "删除 #{gen} 在当前批次的全部档位？" },
                          class: "btn btn-link btn-sm text-danger" %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="inline-new-row">
        <th>
          <select name="generic_part_no" class="form-select form-select-sm" required>
            <option value="" selected disabled>通用型号*</option>
            <%= options_for_select(Item.where.not(generic_part_no: nil).distinct.order(:generic_part_no).pluck(:generic_part_no)) %>
          </select>
        </th>
        <% [ "OEM", "ODM" ].each do |channel| %>
          <% @tiers.each do |q| %>
            <th><input name="tiers[<%= channel %>][<%= q %>]" type="number" step="any" min="0"
                       class="form-control form-control-sm" style="width: 5.5rem;"></th>
          <% end %>
        <% end %>
        <th>
          <button type="submit" class="btn btn-sm btn-primary">增补</button>
          <div class="small text-muted">最新批次</div>
        </th>
      </tr>
    </tfoot>
  </table>
  <% end %>
  <% else %>
  <table class="table table-striped datatable">
    <thead>
      <tr>
        <th>通用型号</th>
        <th colspan="<%= @tiers.size %>">OEM</th>
        <th colspan="<%= @tiers.size %>">ODM</th>
      </tr>
      <tr>
        <th>数量档</th>
        <% PriceListEntry::TIER_LABELS.each do |lb| %><th><%= lb %></th><% end %>
        <% PriceListEntry::TIER_LABELS.each do |lb| %><th><%= lb %></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @entries.group_by(&:generic_part_no).each do |gen, rows| %>
        <tr>
          <td><strong><%= gen %>*</strong></td>
          <% [ "OEM", "ODM" ].each do |channel| %>
            <% @tiers.each do |q| %>
              <% e = rows.find { |r| r.sell_by == channel && r.min_qty == q } %>
              <td class="text-end"><%= e ? money(e.price) : "-" %></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
<% else %>
  <p>暂无阶梯数据。请导入 Excel 或在最新批次增补。</p>
<% end %>

<% if @latest %>
  <p>
    <a class="btn btn-primary" data-bs-toggle="collapse" href="#importCollapse" role="button" aria-expanded="false">
      导入整表 Excel（新建发布批次）
    </a>
    <span class="form-text d-inline-block ms-2">增补：填通用型号 + 各档单价，一次写入 16 档（空白档跳过），归入最新批次。</span>
  </p>
  <div class="collapse" id="importCollapse">
    <div class="card card-body">
      <p class="form-text">导入对账模板的「阶梯价格」表格式：一行一个通用型号，OEM 8 档与 ODM 8 档左右并排（列：通用型号 | 空 | 空 | 1+ | 1K+ | 2.5K+ … 100K+ | 空 | 1+ | 1K+ | 2.5K+ … 100K+），空档跳过。整表导入会创建一个新的发布批次，不影响历史批次。表格末尾的「发布日期」行（如有）将作为批次日期。</p>
      <%= form_tag import_price_lists_path, multipart: true do %>
        <%= file_field_tag :file, class: "form-control" %>
        <%= submit_tag "导入新批次", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% else %>
  <p class="text-muted">暂无发布批次：请通过“导入整表 Excel”创建第一个批次。</p>
  <div class="card card-body">
    <%= form_tag import_price_lists_path, multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "导入新批次", class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>
