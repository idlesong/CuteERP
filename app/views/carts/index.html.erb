<h1>Listing carts</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>cart id</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @carts.each do |cart| %>
      <tr>
        <td><%= cart.id %></td>
        <td><%= link_to "Show", cart %></td>
        <td><%= link_to "Edit", edit_cart_path(cart) %></td>
        <td><%= link_to "Destroy", cart, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br />

<%= link_to "New Cart", new_cart_path %>
