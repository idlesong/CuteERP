<% cart = local_assigns[:cart] || @cart %>
<table class="table">
  <thead>
    <tr>
      <th><h4>#</h4></th>
      <th><h4><%= t(:product_name) %></h4></th>
      <th><h4><%= t(:part_number) %></h4></th>
      <th><h4><%= t(:price) %></h4></th>
      <th><h4><%= t(:quantity) %></h4></th>
      <th><h4><%= t(:suble_total) %></h4></th>
      <th><h4><%= t(:remark) %></h4></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% exchange_rate = 1 %>
    <% currency = current_cart_currency if currency.nil? %>

    <% currency_unit = current_cart_currency == "RMB" ? "¥" : "$" %>
    <% cart.line_items.each_with_index do |line_item, index| %>
      <tr>
        <td><%= link_to index + 1, line_item_path(line_item.id) %></td>
        <td><%= line_item.full_name %></td>
        <td><%= line_item.full_part_number %></td>
        <td>
          <% line_price = line_item.show_currency_price(exchange_rate, currency) %>
          <% if currency_unit == "$" %>
            <a data-bs-toggle="tooltip" data-bs-placement="top" title="=(<%= line_item.fixed_price %>)/1.13/<%= exchange_rate %>">
              <%= number_to_currency(line_price, unit: currency_unit) %></a>
          <% else %>
            <%= number_to_currency(line_price, unit: currency_unit) %>
          <% end %>
        </td>
        <td><%= line_item.quantity %></td>
        <td><%= number_to_currency(line_item.total_currency_price(exchange_rate, currency), unit: currency_unit) %></td>
        <td><%= line_item.remark %></td>
        <td>
          <%= link_to t("helpers.links.destroy", default: t("helpers.links.destroy")), line_item,
                      data: { turbo_method: :delete },
                      class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
    <tr>
      <td colspan="8"><a type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#productsModal"><%= t(:add_product_to_order) %></a></td>
    </tr>
  </tbody>
</table>
