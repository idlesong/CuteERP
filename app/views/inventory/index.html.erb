<h3>Inventory Catalog</h3>
<table class="table table-striped">
  <thead>
    <tr>
      <th>PartNo</th>
      <th>Name</th>
      <th>Package</th>
      <th>Price</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <tr class="<%= cycle("list_line_odd", "list_line_even") %>">
        <td><%= item.partNo %></td>
        <td><%= item.name %></td>
        <td><%= item.package %></td>
        <td></td>
        <td></td>
      </tr>
    <% end %>
  </tbody>
</table>

