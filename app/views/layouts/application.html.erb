<!DOCTYPE html>
<html>
  <head>
    <title>WebERP System Online</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-erp px-3">
      <a class="navbar-brand" href="/"><i class="bi bi-briefcase"></i> CuteERP</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="导航">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <% if current_user %>
            <li class="nav-item"><%= link_to "客户订单", orders_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "六联单", sales_orders_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "出货", shipments_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "客户", customers_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "产品", items_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "价格", prices_path, class: "nav-link" %></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">更多</a>
              <ul class="dropdown-menu">
                <li><%= link_to "文档", posts_path, class: "dropdown-item" %></li>
                <li><%= link_to "阶梯价目", price_lists_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <li><%= link_to "业务机会", opportunities_path, class: "dropdown-item" %></li>
                <li><%= link_to "工作动态", tasks_path, class: "dropdown-item" %></li>
                <li><%= link_to "联系人", contacts_path, class: "dropdown-item" %></li>
                <li><%= link_to "导出当月", exports_path, class: "dropdown-item" %></li>
                <li><%= link_to "导入", imports_path, class: "dropdown-item" %></li>
                <li><%= link_to "月度对账", statement_path, class: "dropdown-item" %></li>
                <li><%= link_to "关账与归档", closed_periods_path, class: "dropdown-item" %></li>
                <li><%= link_to "年度计划", sales_plans_path, class: "dropdown-item" %></li>
                <li><%= link_to "库存", inventory_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <li><%= link_to "汇率设置", exchange_rates_path, class: "dropdown-item" %></li>
                <li><%= link_to "系统设置", users_path, class: "dropdown-item" %></li>
              </ul>
            </li>
          <% end %>
        </ul>
        <ul class="navbar-nav">
          <% if current_user %>
            <li class="nav-item"><%= link_to workbench_path, class: "nav-link me-2" do %><i class="bi bi-person"></i> @<%= current_user.name %><% end %></li>
            <li class="nav-item"><%= link_to t(:logout), "/logout", class: "nav-link" %></li>
          <% else %>
            <li class="nav-item"><%= link_to t(:login), "/login", class: "nav-link" %></li>
          <% end %>
        </ul>
      </div>
    </nav>

    <div class="container-fluid px-3 py-3">
      <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
        <% flash.each do |type, message| %>
          <div class="toast align-items-center text-bg-<%= type == "notice" ? "primary" : "danger" %> border-0"
               role="alert" data-bs-autohide="<%= type == "notice" %>" data-bs-delay="4000">
            <div class="d-flex">
              <div class="toast-body"><%= message %></div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="关闭"></button>
            </div>
          </div>
        <% end %>
      </div>
      <script>
        document.addEventListener("turbo:load", () => {
          document.querySelectorAll(".toast-container .toast").forEach((el) => Bootstrap.Toast.getOrCreateInstance(el).show())
        })
      </script>
      <%= yield %>
    </div>
  </body>
</html>
