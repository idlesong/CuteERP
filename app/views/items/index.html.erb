<%- model_class = Item -%>
<div class="page-header">
  <h1><%= t(:product) %></h1>
</div>


<%# 快速创建独立表单：tfoot 控件通过 form= 属性挂接 %>
<%= form_tag items_path(inline: 1), id: "item-new-form" do end %>
<%# 行内快速编辑：form 置于表格外，行内控件以 form= 关联（form 写进 tr 属非法嵌套，
    部分浏览器解析时会把整行/控件移出表格 → 编辑行消失、DataTables 行数错乱、快捷编辑往返跳顶） %>
<% if params[:edit_id].present? %>
  <%= form_tag item_path(params[:edit_id].to_i), method: :patch, id: "item-edit-form" do %>
    <input type="hidden" name="inline_edit" value="1">
  <% end %>
<% end %>

<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th>通用型号</th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:description) %></th>
      <th>类别</th>
      <th>base_item</th>
      <th>extra_item</th>
      <th>extra_item2</th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <% if params[:edit_id].to_i == item.id %>
        <%# 输入单元格内放 visually-hidden 文本锚点：DataTables 筛选/排序读 textContent，
            锚点保证编辑行与普通行同口径——否则恢复的列筛选匹配不到编辑行 → 行被过滤「消失」 %>
        <tr class="table-warning">
          <td class="text-nowrap" data-order="<%= item.partNo %>">
            <span class="visually-hidden"><%= item.partNo %></span>
            <input form="item-edit-form" name="item[generic_part_no]" value="<%= item.generic_part_no %>" class="form-control form-control-sm d-inline-block" style="width: 8rem;" required> -
            <input form="item-edit-form" name="item[suffix]" value="<%= item.suffix %>" class="form-control form-control-sm d-inline-block" style="width: 3.5rem;">
          </td>
          <td><span class="visually-hidden"><%= item.name %></span>
              <input form="item-edit-form" name="item[name]" value="<%= item.name %>" class="form-control form-control-sm" required></td>
          <td><span class="visually-hidden"><%= item.description %></span>
              <input form="item-edit-form" name="item[description]" value="<%= item.description %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= item.group %></span>
              <input form="item-edit-form" name="item[group]" value="<%= item.group %>" class="form-control form-control-sm" list="item_group_options_edit">
              <datalist id="item_group_options_edit">
                <%= options_for_select(Item.where.not(group: nil).distinct.order(:group).pluck(:group)) %>
              </datalist>
          </td>
          <td><span class="visually-hidden"><%= item.base_item %></span>
              <input form="item-edit-form" name="item[base_item]" value="<%= item.base_item %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= item.extra_item %></span>
              <input form="item-edit-form" name="item[extra_item]" value="<%= item.extra_item %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= item.extra_item2 %></span>
              <input form="item-edit-form" name="item[extra_item2]" value="<%= item.extra_item2 %>" class="form-control form-control-sm"></td>
          <td class="text-nowrap">
            <button type="submit" form="item-edit-form" class="btn btn-sm btn-primary">保存</button>
            <%= link_to "取消", items_path(request.query_parameters.except("edit_id")), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% else %>
        <tr>
          <td><%= link_to item.partNo, item_path(item) %></td>
          <td><%= item.name %></td>
          <%# 描述默认显示 25 个汉字（≈50 字母），超长省略号+悬浮 title 全文；锚点保列筛选按全文匹配 %>
          <td title="<%= item.description %>"><%= truncate(item.description.to_s, length: 25, omission: "…") %><span class="visually-hidden"><%= item.description %></span></td>
          <td><%= item.group %></td>
          <td><%= item.base_item %></td>
          <td><%= item.extra_item %></td>
          <td><%= item.extra_item2 %></td>
          <td><%# 编辑链接带当前 query：回到编辑视图时上下文不丢（客户端筛选由 stateSave 恢复） %>
              <%= link_to "编辑", items_path(request.query_parameters.merge(edit_id: item.id)), class: "btn btn-link btn-sm" %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th><input name="item[generic_part_no]" form="item-new-form" class="form-control form-control-sm" placeholder="型号*" required></th>
      <th><input name="item[name]" form="item-new-form" class="form-control form-control-sm" placeholder="产品名称*" required></th>
      <th><input name="item[description]" form="item-new-form" class="form-control form-control-sm" placeholder="描述"></th>
      <th>
        <input name="item[group]" form="item-new-form" class="form-control form-control-sm" list="item_group_options" placeholder="类别">
        <datalist id="item_group_options">
          <%= options_for_select(Item.where.not(group: nil).distinct.order(:group).pluck(:group)) %>
        </datalist>
      </th>
      <th><input name="item[base_item]" form="item-new-form" class="form-control form-control-sm" placeholder="base"></th>
      <th><input name="item[extra_item]" form="item-new-form" class="form-control form-control-sm" placeholder="extra1"></th>
      <th><input name="item[extra_item2]" form="item-new-form" class="form-control form-control-sm" placeholder="extra2"></th>
      <th><button type="submit" form="item-new-form" class="btn btn-sm btn-primary">快速创建</button></th>
    </tr>
  </tfoot>
</table>

<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整字段）", new_item_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_items_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>
