<%- model_class = Item -%>
<div class="page-header">
  <h1><%= t(:product) %></h1>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <%= form_with model: Item.new(index: 1), url: items_path, html: { class: "row g-2 align-items-end" } do |f| %>
      <%= f.hidden_field :inline, value: "1" %>
      <div class="col-auto"><%= f.text_field :generic_part_no, placeholder: "通用型号*", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.text_field :suffix, placeholder: "后缀", class: "form-control form-control-sm", style: "width: 4.5rem;" %></div>
      <div class="col-auto"><%= f.text_field :name, placeholder: "名称*", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.text_field :group, placeholder: "大类", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.text_field :family, placeholder: "家族", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.submit "快速创建", class: "btn btn-sm btn-primary" %></div>
      <div class="col-auto"><%= link_to "高级创建（完整字段）", new_item_path, class: "btn btn-sm btn-outline-secondary" %></div>
    <% end %>
  </div>
</div>

<table class="table table-striped datatable">
  <thead>
    <tr>
      <th>id</th>
      <th><%= t(:part_number) %></th>
      <th><%= t(:product_group) %></th>
      <th><%= t(:product_family) %></th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:description) %></th>
      <th><%= t(:package) %></th>
      <th><%= t(:mpq) %></th>
      <th><%= t(:assembled) %></th>
      <th><%= t(:base_item) %></th>
      <th><%= t(:extra_item) %></th>
      <th>active</th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.id %></td>
        <td><%= link_to item.partNo, item_path(item) %></td>
        <td><%= item.group %></td>
        <td><%= item.family %></td>
        <td><%= item.name %></td>
        <td><%= item.description %></td>
        <td><%= item.package %></td>
        <td><%= item.mop %></td>
        <td><%= item.assembled %></td>
        <td><%= item.base_item %></td>
        <td><%= item.extra_item %></td>
        <td><%= item.index %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "高级创建（完整字段）", new_item_path, class: "btn btn-outline-secondary btn-sm" %>

<p>
  <br />
  <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
    Advanced: Export, Import products
  </a>
</p>
<div class="collapse" id="collapseExample">
  <div class="card card-body">
    <h4>Export Produts:</h4>
    <%= link_to "Export CSV", items_path(format: "csv"), class: "btn btn-primary" %> |
    <%= link_to "Export Excel", items_path(format: "xls"), class: "btn btn-primary" %>

    <h4>Import Products</h4>
    <%= form_tag import_items_path, multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "Import", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<br />
<br />
