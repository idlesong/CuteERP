<%- model_class = Item -%>
<div class="page-header">
  <h1><%= t(:product) %></h1>
</div>


<%# 快速创建独立表单：tfoot 控件通过 form= 属性挂接 %>
<%= form_tag items_path(inline: 1), id: "item-new-form" do end %>

<table class="table table-striped datatable">
  <thead>
    <tr>
      <th>型号</th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:description) %></th>
      <th>类别</th>
      <th>base_item</th>
      <th>extra_item</th>
      <th>extra_item2</th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <% if params[:edit_id].to_i == item.id %>
        <tr class="table-warning">
          <%= form_tag item_path(item), method: :patch do %>
            <input type="hidden" name="inline_edit" value="1">
            <td class="text-nowrap" data-order="<%= item.partNo %>">
              <input name="item[generic_part_no]" value="<%= item.generic_part_no %>" class="form-control form-control-sm d-inline-block" style="width: 8rem;" required> -
              <input name="item[suffix]" value="<%= item.suffix %>" class="form-control form-control-sm d-inline-block" style="width: 3.5rem;">
            </td>
            <td><input name="item[name]" value="<%= item.name %>" class="form-control form-control-sm" required></td>
            <td><input name="item[description]" value="<%= item.description %>" class="form-control form-control-sm"></td>
            <td>
              <input name="item[group]" value="<%= item.group %>" class="form-control form-control-sm" list="item_group_options_edit">
              <datalist id="item_group_options_edit">
                <%= options_for_select(Item.where.not(group: nil).distinct.order(:group).pluck(:group)) %>
              </datalist>
            </td>
            <td><input name="item[base_item]" value="<%= item.base_item %>" class="form-control form-control-sm"></td>
            <td><input name="item[extra_item]" value="<%= item.extra_item %>" class="form-control form-control-sm"></td>
            <td><input name="item[extra_item2]" value="<%= item.extra_item2 %>" class="form-control form-control-sm"></td>
            <td class="text-nowrap">
              <button type="submit" class="btn btn-sm btn-primary">保存</button>
              <%= link_to "取消", items_path, class: "btn btn-sm btn-outline-secondary" %>
            </td>
          <% end %>
        </tr>
      <% else %>
        <tr>
          <td><%= link_to item.partNo, item_path(item) %></td>
          <td><%= item.name %></td>
          <td><%= item.description %></td>
          <td><%= item.group %></td>
          <td><%= item.base_item %></td>
          <td><%= item.extra_item %></td>
          <td><%= item.extra_item2 %></td>
          <td><%= link_to "编辑", items_path(edit_id: item.id), class: "btn btn-link btn-sm" %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th><input name="item[generic_part_no]" form="item-new-form" class="form-control form-control-sm" placeholder="型号*" required></th>
      <th><input name="item[name]" form="item-new-form" class="form-control form-control-sm" placeholder="产品名称*" required></th>
      <th><input name="item[description]" form="item-new-form" class="form-control form-control-sm" placeholder="描述"></th>
      <th>
        <input name="item[group]" form="item-new-form" class="form-control form-control-sm" list="item_group_options" placeholder="类别">
        <datalist id="item_group_options">
          <%= options_for_select(Item.where.not(group: nil).distinct.order(:group).pluck(:group)) %>
        </datalist>
      </th>
      <th><input name="item[base_item]" form="item-new-form" class="form-control form-control-sm" placeholder="base"></th>
      <th><input name="item[extra_item]" form="item-new-form" class="form-control form-control-sm" placeholder="extra1"></th>
      <th><input name="item[extra_item2]" form="item-new-form" class="form-control form-control-sm" placeholder="extra2"></th>
      <th><button type="submit" form="item-new-form" class="btn btn-sm btn-primary">快速创建</button></th>
    </tr>
  </tfoot>
</table>

<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整字段）", new_item_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 CSV", items_path(format: "csv"), data: { turbo: false }, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 Excel", items_path(format: "xls"), data: { turbo: false }, class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_items_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>
