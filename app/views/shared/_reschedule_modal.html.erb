<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="rescheduleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rescheduleModalLabel"><%= t(:add_ship_status) %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= form_tag sales_orders_path, method: :put, id: "ship_status" do %>
          <div>
            <%= hidden_field_tag "sales_order[delivery_status]", "reschedule" %>
            <%= date_select :sales_order, :delivery_plan, class: "form-select" %><br><br>
            <%= submit_tag "Re-schedule", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
