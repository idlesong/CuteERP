<%= form_with model: @customer, html: { class: "form-horizontal" } do |f| %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :address, class: "form-label" %>
    <%= f.text_area :address, class: "form-control", rows: 4, placeholder: "Please enter address" %>
  </div>
  <div class="mb-3">
    <%= f.label :since, class: "form-label" %>
    <%= f.date_select :since, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :balance, class: "form-label" %>
    <%= f.text_field :balance, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :contact, class: "form-label" %>
    <%= f.text_field :contact, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :telephone, class: "form-label" %>
    <%= f.text_field :telephone, class: "form-control" %>
  </div>

  <div class="form-actions">
    <%= f.submit nil, class: "btn btn-primary" %>
    <%= link_to t("helpers.links.cancel", default: t("helpers.links.cancel")), customers_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
