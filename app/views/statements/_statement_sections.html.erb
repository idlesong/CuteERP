<%# 单客户月度对账三段（订单核对/出货核对/未交订单）——月度对账页与客户详情页共用
    locals: statement MonthlyStatement；customer Customer；month Date（对账月首日） %>
<% ot = statement.order_totals
   st_t = statement.shipment_totals %>
<h5>订单核对段 <small class="text-muted">当月接收的已提交订单行（<%= statement.currency %>）· 按接收日期排序</small></h5>
<table id="stmt-orders-c<%= customer.id %>" class="table table-striped table-sm datatable">
  <thead>
    <tr><th data-filter="month">日期</th><th>单据号</th><th>通用型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th><th>版本</th></tr>
  </thead>
  <tbody>
    <% statement.order_rows.each do |r| %>
      <tr>
        <td><%= r.date %></td>
        <td><%= r.doc_no %></td>
        <td><%= r.part %></td>
        <td class="text-end"><%= r.quantity %></td>
        <td class="text-end"><%= money(r.unit_price, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
        <td><%= r.extra %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="table-secondary fw-bold">
      <td colspan="3">合计</td>
      <td class="text-end"><%= ot[:qty] %></td>
      <td></td>
      <td class="text-end"><%= money(ot[:amount], statement.currency) %></td>
      <td class="text-end"><%= money(ot[:amount_rmb], "RMB") %></td>
      <td></td>
    </tr>
  </tfoot>
</table>

<h5 class="mt-3">出货核对段 <small class="text-muted">当月出库明细（<%= statement.currency %>）</small></h5>
<table id="stmt-shipments-c<%= customer.id %>" class="table table-striped table-sm datatable">
  <thead>
    <tr><th data-filter="month">出库日期</th><th>六联单号</th><th>型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th><th>快递号</th></tr>
  </thead>
  <tbody>
    <% statement.shipment_rows.each do |r| %>
      <tr>
        <td><%= r.date %></td>
        <td><%= r.doc_no %></td>
        <td><%= r.part %></td>
        <td class="text-end"><%= r.quantity %></td>
        <td class="text-end"><%= money(r.unit_price, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
        <td><%= r.extra %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="table-secondary fw-bold">
      <td colspan="3">合计</td>
      <td class="text-end"><%= st_t[:qty] %></td>
      <td></td>
      <td class="text-end"><%= money(st_t[:amount], statement.currency) %></td>
      <td class="text-end"><%= money(st_t[:amount_rmb], "RMB") %></td>
      <td></td>
    </tr>
  </tfoot>
</table>

<h5 class="mt-3">未交订单（截至 <%= month.end_of_month.strftime('%Y-%m-%d') %>） <small class="text-muted">订单量 − 冲销 − 已出货</small></h5>
<table id="stmt-backlog-c<%= customer.id %>" class="table table-striped table-sm datatable">
  <thead>
    <tr><th>订单行</th><th>通用型号</th><th class="text-end">订单量</th><th class="text-end">未交数量</th><th class="text-end">单价</th><th class="text-end">未交金额</th><th class="text-end">折RMB</th><th>版本</th></tr>
  </thead>
  <tbody>
    <% statement.backlog_rows.each do |r| %>
      <tr>
        <td><%= r.doc_no %></td>
        <td><%= r.part %></td>
        <td class="text-end"><%= r.quantity %></td>
        <td class="text-end fw-bold"><%= r.quantity %></td>
        <td class="text-end"><%= money(r.unit_price, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount, statement.currency) %></td>
        <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
        <td><%= r.extra %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="table-secondary fw-bold">
      <td colspan="3">合计</td>
      <td class="text-end"><%= statement.backlog_totals[:qty] %></td>
      <td></td>
      <td class="text-end"><%= money(statement.backlog_totals[:amount], statement.currency) %></td>
      <td class="text-end"><%= money(statement.backlog_totals[:amount_rmb], "RMB") %></td>
      <td></td>
    </tr>
  </tfoot>
</table>
