<div class="page-header"><h1>月度对账单 <small>---客户 × 月份（销售 × 财务核对）</small></h1></div>

<%= form_tag statement_path, method: :get, class: "card mb-3" do %>
  <div class="card-body py-2">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small mb-0">客户</label>
        <select name="customer_id" class="form-select form-select-sm" required data-searchable>
          <option value="" selected disabled>选择客户*</option>
          <option value="all" <%= "selected" if params[:customer_id] == "all" %>>所有客户</option>
          <%= options_from_collection_for_select(Customer.order(:name_zh, :name), :id, ->(c) { cust_name(c) }, @customer&.id) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">月份</label>
        <input type="month" name="month" value="<%= @month.strftime('%Y-%m') %>" class="form-control form-control-sm" required>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">生成对账单</button>
        <%= link_to "导出全部客户内部对账单", export_internal_statement_path(month: @month.strftime("%Y-%m")),
                    class: "btn btn-sm btn-outline-secondary", data: { turbo: false },
                    title: "全部客户合成一张表：币别→客户→日期排序，金额按 芯片/声码1/声码2 成分拆分，按币别小计" %>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">汇总起始月（YYYY-MM）</label>
        <input type="text" name="from" value="<%= params[:from].presence %>" class="form-control form-control-sm" placeholder="2026-01" form="summary-form">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">截止月（可缺省，限 24 个月）</label>
        <input type="text" name="to" value="<%= params[:to].presence %>" class="form-control form-control-sm" placeholder="2026-12" form="summary-form">
      </div>
      <div class="col-auto">
        <%= submit_tag "导出区间汇总", form: "summary-form", class: "btn btn-sm btn-outline-secondary",
                       data: { turbo: false },
                       title: "每月一个 sheet（订单核对/出货核对/未交订单/排产核对 四段纵向），合成一个工作簿" %>
      </div>
    </div>
  </div>
<% end %>

<%# 区间汇总独立表单（位于顶部筛选条内，任何视图状态均可用；字段以 form 属性跨表单关联） %>
<%= form_tag export_summary_statement_path, method: :get, id: "summary-form", class: "d-none" do %><% end %>

<% if @internal %>
  <%# 全部客户：按客户币别拆「人民币/美元」两段分节显示（去币别/附加列，日期首列），各节小计 + 段合计折 RMB %>
  <% sections = ->(rows) { rows.group_by { |r| r.currency == "USD" ? "美元客户(USD)" : "人民币客户" } } %>

  <h5>订单核对段 <small class="text-muted">全部客户 · 含冲销 · 客户币别分段 · 日期排序 · 单价链接=报价详情</small></h5>
  <% sections.call(@internal.order_rows).each do |section, rows| %>
    <% t = @internal.totals_by_currency(@internal.order_rows)[rows.first.currency] %>
    <table id="stmt-orders-<%= (rows.first.currency || 'RMB').downcase %>" class="table table-striped table-sm datatable">
      <thead>
        <tr><th data-filter="month">日期</th><th>客户</th><th>单据号</th><th>通用型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th></tr>
      </thead>
      <tbody>
        <% rows.each do |r| %>
          <tr>
            <td><%= r.date %></td>
            <td><%= r.customer %></td>
            <td><%= r.doc_no %></td>
            <td><%= r.part %></td>
            <td class="text-end"><%= r.quantity %></td>
            <%# 报价号列已去除：单价即链接，点击进报价详情（无报价时纯文本） %>
            <td class="text-end"><%= r.price_id ? link_to(money((r.chip_price + r.v1_price + r.v2_price).round(2), r.currency), price_path(r.price_id)) : money((r.chip_price + r.v1_price + r.v2_price).round(2), r.currency) %></td>
            <td class="text-end"><%= money(r.amount, r.currency) %></td>
            <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td colspan="4"><%= section %> 小计</td>
          <td class="text-end"><%= t[:qty] %></td>
          <td></td>
          <td class="text-end"><%= money(t[:amount], rows.first.currency) %></td>
          <td class="text-end"><%= money(t[:amount_rmb], "RMB") %></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
  <div class="small text-muted mb-3">段合计（跨币别按 RMB）：数量 <%= @internal.order_totals[:qty] %> · 折RMB <%= money(@internal.order_totals[:amount_rmb], "RMB") %></div>

  <h5 class="mt-3">出货核对段 <small class="text-muted">全部客户出库明细</small></h5>
  <% sections.call(@internal.shipment_rows).each do |section, rows| %>
    <% t = @internal.totals_by_currency(@internal.shipment_rows)[rows.first.currency] %>
    <table id="stmt-shipments-<%= (rows.first.currency || 'RMB').downcase %>" class="table table-striped table-sm datatable">
      <thead>
        <tr><th data-filter="month">出库日期</th><th>客户</th><th>六联单号</th><th>型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th></tr>
      </thead>
      <tbody>
        <% rows.each do |r| %>
          <tr>
            <td><%= r.date %></td>
            <td><%= r.customer %></td>
            <td><%= r.doc_no %></td>
            <td><%= r.part %></td>
            <td class="text-end"><%= r.quantity %></td>
            <td class="text-end"><%= money((r.chip_price + r.v1_price + r.v2_price).round(2), r.currency) %></td>
            <td class="text-end"><%= money(r.amount, r.currency) %></td>
            <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td colspan="4"><%= section %> 小计</td>
          <td class="text-end"><%= t[:qty] %></td>
          <td></td>
          <td class="text-end"><%= money(t[:amount], rows.first.currency) %></td>
          <td class="text-end"><%= money(t[:amount_rmb], "RMB") %></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
  <div class="small text-muted mb-3">段合计（跨币别按 RMB）：数量 <%= @internal.shipment_totals[:qty] %> · 折RMB <%= money(@internal.shipment_totals[:amount_rmb], "RMB") %></div>

  <h5 class="mt-3">未交订单（截至 <%= @month.end_of_month.strftime('%Y-%m-%d') %>） <small class="text-muted">订单量 − 冲销 − 已出货</small></h5>
  <% sections.call(@internal.backlog_rows).each do |section, rows| %>
    <% t = @internal.totals_by_currency(@internal.backlog_rows)[rows.first.currency] %>
    <table id="stmt-backlog-<%= (rows.first.currency || 'RMB').downcase %>" class="table table-striped table-sm datatable">
      <thead>
        <tr><th>订单行</th><th>客户</th><th>通用型号</th><th class="text-end">未交数量</th><th class="text-end">单价</th><th class="text-end">未交金额</th><th class="text-end">折RMB</th></tr>
      </thead>
      <tbody>
        <% rows.each do |r| %>
          <tr>
            <td><%= r.doc_no %></td>
            <td><%= r.customer %></td>
            <td><%= r.part %></td>
            <td class="text-end fw-bold"><%= r.quantity %></td>
            <td class="text-end"><%= r.price_id ? link_to(money((r.chip_price + r.v1_price + r.v2_price).round(2), r.currency), price_path(r.price_id)) : money((r.chip_price + r.v1_price + r.v2_price).round(2), r.currency) %></td>
            <td class="text-end"><%= money(r.amount, r.currency) %></td>
            <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td colspan="3"><%= section %> 小计</td>
          <td class="text-end"><%= t[:qty] %></td>
          <td></td>
          <td class="text-end"><%= money(t[:amount], rows.first.currency) %></td>
          <td class="text-end"><%= money(t[:amount_rmb], "RMB") %></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
  <div class="small text-muted mb-3">段合计（跨币别按 RMB）：数量 <%= @internal.backlog_totals[:qty] %> · 折RMB <%= money(@internal.backlog_totals[:amount_rmb], "RMB") %></div>

  <h5 class="mt-3">排产核对（当月下发六联单 + 分配台账） <small class="text-muted">可与 Excel 六联单表 FIFO 分配公式结果逐行对照</small></h5>
  <table id="stmt-alloc" class="table table-striped table-sm datatable">
    <thead>
      <tr><th>下单日期</th><th>六联单号</th><th>客户</th><th>产品</th><th class="text-end">数量</th><th>版本</th><th>分配明细（订单行×数量）</th><th class="text-end">Σ分配</th><th class="text-end">已发货</th><th>状态</th></tr>
    </thead>
    <tbody>
      <% @internal.allocation_rows.each do |r| %>
        <tr class="<%= "table-warning" if r.alloc_total != r.quantity %>">
          <td><%= r.date %></td>
          <td><%= r.serial %></td>
          <td><%= r.customer %></td>
          <td><%= r.part %></td>
          <td class="text-end"><%= r.quantity %></td>
          <td><%= r.version %></td>
          <td class="small"><%= r.alloc_detail.presence || "（无分配）" %></td>
          <td class="text-end <%= "fw-bold text-danger" if r.alloc_total != r.quantity %>"><%= r.alloc_total %></td>
          <td class="text-end"><%= r.shipped_qty %></td>
          <td><%= r.status %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <% t = @internal.allocation_totals %>
      <tr class="table-secondary fw-bold">
        <td colspan="4">合计</td>
        <td class="text-end"><%= t[:qty] %></td>
        <td colspan="2"></td>
        <td class="text-end <%= "text-danger" if t[:alloc] != t[:qty] %>"><%= t[:alloc] %></td>
        <td class="text-end"><%= t[:shipped] %></td>
        <td></td>
      </tr>
    </tfoot>
  </table>
  <div class="small text-muted mb-3">Σ分配 ≠ 数量 的行以黄色高亮（需人工检查分配）。</div>

  <h5 class="mt-3">价格依据 <small class="text-muted">对账月生效中的报价（标记本月新生效/本月失效）——交易单价的核对依据</small></h5>
  <% pt = @internal.price_totals %>
  <table id="stmt-prices" class="table table-striped table-sm datatable">
    <thead>
      <tr><th>报价号</th><th>客户</th><th>通用型号</th><th>档位</th><th class="text-end">芯片</th><th class="text-end">声码1</th><th class="text-end">声码2</th><th class="text-end">总单价</th><th>生效日期</th><th>失效日期</th><th>币别</th><th>状态</th><th>备注</th></tr>
    </thead>
    <tbody>
      <% @internal.price_rows.each do |r| %>
        <tr class="<%= "table-info" if r.flag == "本月新生效" %><%= " table-warning" if r.flag == "本月失效" %>">
          <td><%= r.price_no %></td>
          <td><%= r.customer %></td>
          <td><%= r.part %></td>
          <td><%= r.condition %></td>
          <td class="text-end"><%= r.chip %></td>
          <td class="text-end"><%= r.v1 %></td>
          <td class="text-end"><%= r.v2 %></td>
          <td class="text-end fw-bold"><%= r.price %></td>
          <td><%= r.effective_from %></td>
          <td><%= r.expired_at %></td>
          <td><%= r.currency %></td>
          <td><%= r.status %></td>
          <td><%= r.flag %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="table-secondary fw-bold">
        <td colspan="13">生效中 <%= pt[:count] %> 条（本月新生效 <%= pt[:new] %> · 本月失效 <%= pt[:expired] %>）</td>
      </tr>
    </tfoot>
  </table>

  <div class="mt-2">
    <%= link_to "导出 Excel（全部客户，含成分拆分与币别小计）", export_internal_statement_path(month: @month.strftime("%Y-%m")),
                data: { turbo: false }, class: "btn btn-outline-primary btn-sm" %>
    <span class="small text-muted ms-2">区间汇总导出入口在顶部筛选条（选起止月）。</span>
  </div>
<% end %>

<% if @statement %>
  <%# 三段表格抽成共享 partial：客户详情页「当月对账」复用同一渲染 %>
  <%= render "statements/statement_sections", statement: @statement, customer: @customer, month: @month %>

  <div class="mt-2">
    <%= link_to "导出 Excel", export_statement_path(customer_id: @customer.id, month: @month.strftime('%Y-%m')), data: { turbo: false }, class: "btn btn-outline-primary btn-sm" %>
    <span class="small text-muted ms-2">差异处理：关账前修改源单据后重新生成本页；关账后走冲销单（D1）。</span>
  </div>
<% end %>
