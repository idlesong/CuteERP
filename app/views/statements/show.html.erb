<div class="page-header"><h1>月度对账单 <small>---客户 × 月份（销售 × 财务核对）</small></h1></div>

<%= form_tag statement_path, method: :get, class: "card mb-3" do %>
  <div class="card-body py-2">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small mb-0">客户</label>
        <select name="customer_id" class="form-select form-select-sm" required>
          <option value="" selected disabled>选择客户*</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name, @customer&.id) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-0">月份</label>
        <input type="month" name="month" value="<%= @month.strftime('%Y-%m') %>" class="form-control form-control-sm" required>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">生成对账单</button>
      </div>
    </div>
  </div>
<% end %>

<% if @statement %>
  <% ot = @statement.order_totals
     st_t = @statement.shipment_totals %>
  <h5>订单核对段 <small class="text-muted">当月接收的已提交订单行（<%= @statement.currency %>）</small></h5>
  <table class="table table-striped table-sm">
    <thead>
      <tr><th>日期</th><th>单据号</th><th>通用型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th><th>版本</th></tr>
    </thead>
    <tbody>
      <% @statement.order_rows.each do |r| %>
        <tr>
          <td><%= r.date %></td>
          <td><%= r.doc_no %></td>
          <td><%= r.part %></td>
          <td class="text-end"><%= r.quantity %></td>
          <td class="text-end"><%= money(r.unit_price, @statement.currency) %></td>
          <td class="text-end"><%= money(r.amount, @statement.currency) %></td>
          <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
          <td><%= r.extra %></td>
        </tr>
      <% end %>
      <tr class="table-secondary fw-bold">
        <td colspan="3">合计</td>
        <td class="text-end"><%= ot[:qty] %></td>
        <td></td>
        <td class="text-end"><%= money(ot[:amount], @statement.currency) %></td>
        <td class="text-end"><%= money(ot[:amount_rmb], "RMB") %></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <h5 class="mt-3">出货核对段 <small class="text-muted">当月出库明细（<%= @statement.currency %>）</small></h5>
  <table class="table table-striped table-sm">
    <thead>
      <tr><th>出库日期</th><th>六联单号</th><th>型号</th><th class="text-end">数量</th><th class="text-end">单价</th><th class="text-end">金额</th><th class="text-end">金额折RMB</th><th>快递号</th></tr>
    </thead>
    <tbody>
      <% @statement.shipment_rows.each do |r| %>
        <tr>
          <td><%= r.date %></td>
          <td><%= r.doc_no %></td>
          <td><%= r.part %></td>
          <td class="text-end"><%= r.quantity %></td>
          <td class="text-end"><%= money(r.unit_price, @statement.currency) %></td>
          <td class="text-end"><%= money(r.amount, @statement.currency) %></td>
          <td class="text-end"><%= money(r.amount_rmb, "RMB") %></td>
          <td><%= r.extra %></td>
        </tr>
      <% end %>
      <tr class="table-secondary fw-bold">
        <td colspan="3">合计</td>
        <td class="text-end"><%= st_t[:qty] %></td>
        <td></td>
        <td class="text-end"><%= money(st_t[:amount], @statement.currency) %></td>
        <td class="text-end"><%= money(st_t[:amount_rmb], "RMB") %></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="mt-2">
    <%= link_to "导出 CSV", export_statement_path(customer_id: @customer.id, month: @month.strftime('%Y-%m')), class: "btn btn-outline-primary btn-sm" %>
    <span class="small text-muted ms-2">差异处理：关账前修改源单据后重新生成本页；关账后走冲销单（D1）。</span>
  </div>
<% end %>
