<h1>Listing attachments</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @attachments.each do |attachment| %>
      <tr>
        <td><%= link_to attachment.name, attachment %></td>
        <td><%= attachment.description %></td>
        <td><%= link_to "Show", attachment %></td>
        <td><%= link_to "Edit", edit_attachment_path(attachment) %></td>
        <td><%= link_to "Destroy", attachment, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br />

<%= link_to "New Attachment", new_attachment_path, class: "btn btn-primary" %>
