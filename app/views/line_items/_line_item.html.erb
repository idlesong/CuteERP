<tr id="<%= "current_item" if line_item == @current_item %>">
  <td>1</td>
  <td><%= line_item.item.name %></td>
  <td><%= line_item.item.partNo %></td>
  <td><%= line_item.quantity %></td>
  <td><%= line_item.fixed_price %></td>
  <td><%= number_to_currency(line_item.total_price) %></td>
  <td></td>
</tr>
