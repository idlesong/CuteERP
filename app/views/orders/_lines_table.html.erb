<%# 客户订单行级表格（orders/index 与仪表盘复用）
    locals: lines —— OrderLine 集合（需含 order => customer/end_customer）；
            paging —— false 时 DataTables 关闭分页 %>
<%= form_tag orders_path(inline: 1) do %>
  <%= hidden_field_tag :return_to, local_assigns[:back] %>
<table class="table table-striped datatable" <%= 'data-paging="off"'.html_safe unless local_assigns[:paging] %>>
  <thead>
    <tr>
      <th><%= t(:show_date) %></th>
      <th><%= t(:customer) %> / <%= t(:end_customer) %></th>
      <th><%= t(:po_number) %></th>
      <th>#</th>
      <th><%= t(:part_number) %></th>
      <th><%= t(:quantity) %></th>
      <th><%= t(:price) %></th>
      <th><%= t(:suble_total) %></th>
      <th>版本</th>
      <th><%= t(:quantity_left) %></th>
      <th><%= t(:delivery_date) %></th>
      <th><%= t(:status) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% lines.each do |line| %>
      <% order = line.order %>
      <% currency_unit = order.currency == "USD" ? "$" : "¥" %>
      <tr class="<%= 'table-warning' if order.draft? %> <%= 'table-danger' if order.return? %>">
        <td><%= order.created_at.strftime("%F") %></td>
        <td>
          <%= link_to cust_name(order.customer), order.customer %>
          <% if order.end_customer %>/ <%= cust_name(order.end_customer) %><% end %>
        </td>
        <td><%= order.po_number %></td>
        <td><%= link_to line.line_no, order_path(order) %></td>
        <td><%= line.generic_part_no %></td>
        <td>x<%= line.quantity %></td>
        <td>
          <% if line.price_id %>
            <%= link_to number_to_currency(line.unit_price, unit: currency_unit), price_path(line.price_id) %>
          <% else %>
            <%= number_to_currency(line.unit_price, unit: currency_unit) %>
          <% end %>
        </td>
        <td><%= number_to_currency(line.total_price, unit: currency_unit) %></td>
        <td><%= line.version %></td>
        <td><%= line.quantity_left %></td>
        <td><%= line.required_delivery_date %></td>
        <td>
          <% if order.return? %>
            <span class="badge bg-danger">冲销</span>
          <% elsif order.draft? %>
            <span class="badge bg-secondary">草稿</span>
          <% else %>
            <span class="badge bg-success">已提交</span>
          <% end %>
        </td>
        <td>
          <% if order.draft? %>
            <%= link_to "提交", submit_order_path(order, return_to: local_assigns[:back]),
                        data: { turbo_method: :patch, turbo_confirm: "提交订单 #{order.po_number}（共 #{order.order_lines.size} 行）？" },
                        class: "text-primary" %>
          <% elsif order.submitted? && line.quantity_left > 0 %>
            <% if local_assigns[:back] == "workbench" %>
              <button type="button" class="btn btn-link btn-sm text-primary p-0"
                      data-bs-toggle="modal" data-bs-target="#quickIssueModal"
                      data-ol-id="<%= line.id %>" data-generic="<%= line.generic_part_no %>"
                      data-display="<%= line.display_no %>" data-qty="<%= line.quantity_left %>"
                      data-customer="<%= order.customer_id %>"
                      data-suffixes="<%= line.item_candidates.map(&:suffix).compact.reject(&:empty?).join(',') %>">分解</button>
            <% else %>
              <%= link_to t(:issue), new_sales_order_path(customer_id: order.customer.id) %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th></th>
      <th>
        <select name="order[customer_id]" id="order_customer_id" class="form-select form-select-sm">
          <option value="" selected>客户(新PO必选)</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name) %>
        </select>
      </th>
      <th>
        <input name="order[po_number]" id="order_po_number" class="form-control form-control-sm"
               placeholder="客户订单号*" required>
      </th>
      <th></th>
      <th>
        <select name="order[generic_part_no]" id="order_generic_part_no" class="form-select form-select-sm" required>
          <option value="" selected disabled>型号*</option>
          <%= options_for_select(Item.where.not(generic_part_no: nil).distinct.order(:generic_part_no).pluck(:generic_part_no)) %>
        </select>
      </th>
      <th><input name="order[quantity]" type="number" min="1" class="form-control form-control-sm" placeholder="数量*" required></th>
      <th>
        <select name="order[price_id]" id="order_price_id" class="form-select form-select-sm">
          <option value="" selected disabled>价格*</option>
        </select>
      </th>
      <th></th>
      <th></th>
      <th></th>
      <th><input name="order[required_delivery_date]" type="date" class="form-control form-control-sm"></th>
      <th></th>
      <th><button type="submit" class="btn btn-sm btn-primary">快速创建</button>
          <div id="po-preview" class="small text-muted"></div></th>
    </tr>
  </tfoot>
</table>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
    const poInput = document.getElementById("order_po_number")
    const preview = document.getElementById("po-preview")
    const customerSelect = document.getElementById("order_customer_id")
    const partSelect = document.getElementById("order_generic_part_no")
    const priceSelect = document.getElementById("order_price_id")

    // 客户订单号失焦：预显完整编号（PO-行号），已有 PO 自动带出客户
    if (poInput) {
      poInput.addEventListener("blur", () => {
        const po = poInput.value.trim()
        if (!po) { preview.textContent = ""; return }
        fetch(`/orders/next_line_no?po_number=${encodeURIComponent(po)}`)
          .then((r) => r.json())
          .then((data) => {
            preview.textContent = data.exists
              ? `${data.display_no}（追加到${data.status === "draft" ? "草稿" : "已提交"}单）`
              : `${data.display_no}（新单，请选客户）`
            if (data.exists && customerSelect) {
              customerSelect.value = data.customer_id
              loadPrices()
            }
          }).catch(() => {})
      })
    }

    // 价格下拉 = 已批准/生效价格，按已选客户 + 型号过滤；唯一价格自动选中
    function loadPrices() {
      if (!priceSelect) return
      const params = new URLSearchParams()
      if (customerSelect && customerSelect.value) params.set("customer_id", customerSelect.value)
      if (partSelect && partSelect.value) params.set("part_number", partSelect.value)
      priceSelect.innerHTML = '<option value="" selected disabled>价格*</option>'
      if (!params.toString()) return
      fetch(`/prices/options?${params}`)
        .then((r) => r.json())
        .then((list) => {
          priceSelect.innerHTML = '<option value="" selected disabled>价格*</option>'
          if (list.length === 0) {
            priceSelect.innerHTML = '<option value="" selected disabled>无可用价格</option>'
            return
          }
          list.forEach((p) => {
            const opt = document.createElement("option")
            opt.value = p.id
            opt.textContent = p.label
            priceSelect.appendChild(opt)
          })
          if (list.length === 1) priceSelect.value = list[0].id
        }).catch(() => {})
    }

    // 选客户后：型号下拉只显示该客户有报价的型号
    function loadParts() {
      if (!partSelect || !customerSelect) return
      partSelect.innerHTML = '<option value="" selected disabled>型号*</option>'
      if (!customerSelect.value) return
      fetch(`/prices/options?customer_id=${encodeURIComponent(customerSelect.value)}&parts_only=1`)
        .then((r) => r.json())
        .then((parts) => {
          partSelect.innerHTML = '<option value="" selected disabled>型号*</option>'
          if (parts.length === 0) {
            partSelect.innerHTML = '<option value="" selected disabled>该客户暂无报价型号</option>'
            return
          }
          parts.forEach((pn) => {
            const opt = document.createElement("option")
            opt.value = pn
            opt.textContent = pn
            partSelect.appendChild(opt)
          })
        }).catch(() => {})
    }
    if (customerSelect) customerSelect.addEventListener("change", () => { loadParts(); loadPrices() })
    if (partSelect) partSelect.addEventListener("change", loadPrices)
  })
</script>

<% if local_assigns[:back] == "workbench" %>
<div class="modal fade" id="quickIssueModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <%= form_tag sales_orders_path, class: "modal-content" do %>
      <input type="hidden" name="return_to" value="workbench">
      <input type="hidden" name="sales_order[customer_id]" id="qi_customer">
      <div class="modal-header">
        <h5 class="modal-title">快捷签发 <span id="qi_display" class="text-primary"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">通用型号：<strong id="qi_generic"></strong></div>
        <div class="mb-2">
          <label class="form-label">后缀（拼成正式型号，可手输新后缀）</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text" id="qi_generic_prefix"></span>
            <input name="lines[__OLID__][suffix]" id="qi_suffix" class="form-control" style="width: 5rem;"
                   list="qi_suffix_options" placeholder="如 C">
          </div>
          <datalist id="qi_suffix_options"></datalist>
        </div>
        <div class="mb-2">
          <label class="form-label">数量</label>
          <input name="lines[__OLID__][quantity]" id="qi_quantity" type="number" min="1" class="form-control form-control-sm" required>
        </div>
        <div class="mb-2">
          <label class="form-label">版本</label>
          <input name="lines[__OLID__][version]" id="qi_version" class="form-control form-control-sm">
        </div>
        <div class="small text-muted">签发后回到本页；数量默认为该行全部可分配数。</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
        <%= submit_tag "签发", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", () => {
    const modal = document.getElementById("quickIssueModal")
    if (!modal) return
    modal.addEventListener("show.bs.modal", (e) => {
      const d = e.relatedTarget.dataset
      modal.querySelector("#qi_display").textContent = d.display
      modal.querySelector("#qi_generic").textContent = d.generic
      modal.querySelector("#qi_generic_prefix").textContent = d.generic
      modal.querySelector("#qi_customer").value = d.customer
      const suffix = modal.querySelector("#qi_suffix")
      const qty = modal.querySelector("#qi_quantity")
      const ver = modal.querySelector("#qi_version")
      ;[suffix, qty, ver].forEach((el) => { el.name = el.name.replace(/lines\[\d+\]/, "lines[" + d.olId + "]") })
      suffix.value = ""
      qty.value = d.qty
      qty.max = d.qty
      ver.value = ""
      const dl = modal.querySelector("#qi_suffix_options")
      dl.innerHTML = ""
      ;(d.suffixes || "").split(",").filter(Boolean).forEach((sx) => {
        const o = document.createElement("option")
        o.value = sx
        dl.appendChild(o)
      })
    })
  })
</script>
<% end %>
