<%- model_class = Order -%>
<div class="page-header">
  <h1><%= t(:order) %><small>---按行显示</small></h1>
</div>


<%= render "lines_table", lines: @lines, paging: true %>
<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整表头）", new_order_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 CSV", orders_path(format: "csv"), data: { turbo: false }, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 Excel", orders_path(format: "xls"), class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_orders_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>

