<%= form_with model: @order, html: { multipart: true, class: "card" } do |f| %>
  <% if @order.errors.any? %>
    <div id="error_explanation" class="alert alert-danger" role="alert">
      <ul>
        <% @order.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <%= f.label :customer_id, t(:customer), class: "form-label" %>
        <%= f.select :customer_id, options_from_collection_for_select(@customers, :id, :name, @order.customer_id),
                     { prompt: "选择客户*" }, class: "form-select", required: true %>
      </div>
      <div class="col-md-4">
        <%= f.label :po_number, t(:po_number), class: "form-label" %>
        <%= f.text_field :po_number, class: "form-control", required: true, placeholder: "如 IBM2006001" %>
      </div>
      <div class="col-md-4">
        <%= f.label :end_customer_id, t(:end_customer), class: "form-label" %>
        <%= f.select :end_customer_id,
                     options_from_collection_for_select(Customer.order(:name), :id, :name, @order.end_customer_id),
                     { include_blank: "（ODM 提交时必填）" }, class: "form-select" %>
      </div>
      <div class="col-md-4">
        <%= f.label :pay_type, t(:payment_term), class: "form-label" %>
        <%= f.select :pay_type, Order::PAYMENT_TYPES, { include_blank: true }, class: "form-select" %>
      </div>
      <div class="col-md-4">
        <%= f.label :remark, t(:remark), class: "form-label" %>
        <%= f.text_field :remark, class: "form-control" %>
      </div>
      <div class="col-md-4">
        <%= f.label :exchange_rate, "汇率（留空自动取当月）", class: "form-label" %>
        <%= f.number_field :exchange_rate, class: "form-control", step: "any",
                           value: (@order.exchange_rate if @order.exchange_rate.to_f > 0) %>
      </div>
      <div class="col-12 small text-muted">
        联系人/地址等未填字段将在创建时从客户资料默认带出，发货前可在编辑页修改。
      </div>
    </div>
  </div>
  <div class="card-footer text-center">
    <%= link_to t("helpers.links.cancel", default: "取消"), orders_path, class: "btn btn-outline-secondary" %>
    <%= f.submit "创建草稿订单", class: "btn btn-primary" %>
  </div>
<% end %>
