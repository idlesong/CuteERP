<div class="page-header d-flex justify-content-between align-items-center">
  <h1>核对预览 <small>---批次 #<%= @import.id %>（<%= @import.filename %>）</small></h1>
  <%= link_to "返回导入", imports_path, class: "btn btn-sm btn-outline-secondary" %>
</div>

<% s = @import.stats %>
<div class="alert <%= @import.status == "applied" ? "alert-success" : "alert-info" %>">
  核对区间 <strong><%= s["range"]["from"] %> ~ <%= s["range"]["to"] %></strong>（按文件内单据日期自动检测，整月对齐）。
  状态：<strong><%= @import.status == "applied" ? "已应用 #{s.dig('apply') ? Time.current.strftime('%H:%M') : ''}" : "待确认（预览不落库）" %></strong>
</div>

<% action_badge = {
     "create" => '<span class="badge bg-success">新增</span>',
     "update" => '<span class="badge bg-primary">修改</span>',
     "void" => '<span class="badge bg-warning text-dark">作废</span>',
     "conflict" => '<span class="badge bg-danger">冲突</span>',
     "none" => '<span class="badge bg-secondary">一致</span>'
   } %>

<% [["orders", "订单核对"], ["sales_orders", "销售订单核对"], ["shipments", "发货核对"]].each do |key, title| %>
  <% section = s[key] %>
  <h5 class="mt-3"><%= title %>
    <small class="text-muted">
      新增 <%= section["create"] %> / 修改 <%= section["update"] %> / 作废 <%= section["void"] %> /
      冲突 <%= section["conflict"] %> / 一致 <%= section["skip"] %>
    </small>
  </h5>
  <table class="table table-sm table-striped">
    <thead>
      <tr><th>行</th><th>单据行</th><th>动作</th><th>差异明细</th><th>提示 / 阻断</th></tr>
    </thead>
    <tbody>
      <% section["rows"].each do |r| %>
        <tr class="<%= "table-danger" if r["action"] == "conflict" %>">
          <td><%= r["row_no"] %></td>
          <td class="text-nowrap"><%= r["key"] %></td>
          <td><%= action_badge[r["action"]]&.html_safe %></td>
          <td class="small">
            <% r["fields"].each do |field, (was, now)| %>
              <div><%= field %>：<%= was.inspect %> → <strong><%= now.inspect %></strong></div>
            <% end %>
            <% Array(r["warnings"]).each do |w| %>
              <div class="text-warning-emphasis"><%= w %></div>
            <% end %>
          </td>
          <td class="small">
            <% Array(r["blockers"]).each do |b| %>
              <div class="text-danger">⛔ <%= b %></div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p class="small text-muted"><%= s.dig("backlog", "note") %></p>

<% if @import.status == "preview" %>
  <div class="card border-primary mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <span>
        确认后将<b>事务内应用</b>全部「新增/修改/作废」差异（冲突行跳过）；
        作废 = 已提交行标记 <code>[作废]</code> + 数量置 0（D15，保留追溯）；同一文件只能应用一次。
      </span>
      <%= button_to "确认应用", apply_import_check_path(@import),
                    class: "btn btn-primary", form: { data: { turbo: false } } %>
    </div>
  </div>
<% elsif s["apply"] %>
  <div class="alert alert-success">
    已应用：
    <% s["apply"].each do |section, c| %>
      <%= { "orders" => "订单", "sales_orders" => "六联单", "shipments" => "出货" }[section] %>
      （新增 <%= c["create"] %> / 修改 <%= c["update"] %> / 作废 <%= c["void"] %>）
    <% end %>
  </div>
<% end %>
