<div class="page-header"><h1>销售出货</h1></div>

<%= form_tag shipments_path(inline: 1) do %>
<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th data-filter="month">日期</th>
      <th><%= t(:customer) %></th>
      <th>六联单号</th>
      <th><%= t(:product_name) %></th>
      <th><%= t(:quantity) %></th>
      <th>RMB单价含税</th>
      <th>销售额（不含税）</th>
      <th>产品大类</th>
      <th>客户区域</th>
      <th>快递号</th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @shipments.order(:shipped_at).each do |sh| %>
      <% sh.shipment_lines.each do |sl| %>
        <tr>
          <td><%= sh.shipped_at.strftime("%F") %></td>
          <td><%= cust_name(sh.sales_order.customer) %></td>
          <td><%= link_to sh.sales_order.serial_number, sales_order_path(sh.sales_order) %></td>
          <td><%= sl.production_line&.part_number %></td>
          <td class="text-end"><%= sl.quantity %></td>
          <td class="text-end"><%= money(sl.unit_price_rmb, "RMB") %></td>
          <td class="text-end"><%= money(sl.amount_ex_tax, "RMB") %></td>
          <td><%= sl.production_line&.item&.group %></td>
          <td><%= sh.sales_order.customer.territory %></td>
          <td><%= sh.tracking_no %></td>
          <td><%= link_to "✘", shipment_path(sh), data: { turbo_method: :delete, turbo_confirm: "删除整张出库单？" }, class: "btn btn-link btn-sm text-danger p-0 align-baseline" %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th><input name="shipped_at" type="date" class="form-control form-control-sm"
                 value="<%= Date.current %>"></th>
      <th></th>
      <th>
        <select name="sales_order_id" class="form-select form-select-sm" required>
          <option value="" selected disabled>六联单*</option>
          <% SalesOrder.includes(:production_lines).order(created_at: :desc).each do |so| %>
            <% next if so.production_lines.sum(&:unshipped_qty) <= 0 %>
            <option value="<%= so.id %>"><%= so.serial_number %>（待出 <%= so.production_lines.sum(&:unshipped_qty) %>）</option>
          <% end %>
        </select>
      </th>
      <th class="small text-muted">整单出库（全部未出数量一次出完）</th>
      <th></th>
      <th></th>
      <th></th>
      <th></th>
      <th></th>
      <th><input name="tracking_no" class="form-control form-control-sm" placeholder="快递号"></th>
      <th><button type="submit" class="btn btn-sm btn-primary">快速出库</button></th>
    </tr>
  </tfoot>
</table>
<% end %>
