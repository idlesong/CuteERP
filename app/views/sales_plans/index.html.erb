<div class="page-header d-flex justify-content-between align-items-center">
  <h1>年度销售计划
    <small>---FY<%= @fy %>（<%= @fy - 1 %>-04 ~ <%= @fy %>-03）</small>
  </h1>
  <div class="btn-group">
    <% [SalesPlanEntry.current_fy - 1, SalesPlanEntry.current_fy, SalesPlanEntry.current_fy + 1].each do |y| %>
      <%= link_to "FY#{y}", sales_plans_path(fy: y), class: "btn btn-sm #{y == @fy ? 'btn-primary' : 'btn-outline-secondary'}" %>
    <% end %>
  </div>
</div>

<% if notice %><p class="alert alert-info"><%= notice %></p><% end %>
<% if alert %><p class="alert alert-warning"><%= alert %></p><% end %>

<h5>计划矩阵（数量）</h5>
<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th>大类</th>
      <th>客户</th>
      <% @months.each do |m| %><th><%= m.strftime("%y-%m") %></th><% end %>
      <th>全年</th>
    </tr>
  </thead>
  <tbody>
    <% @matrix.each do |group, customers| %>
      <% customers.each do |cname, cells| %>
        <tr>
          <td><%= group %></td>
          <td><%= cname %></td>
          <% total = 0 %>
          <% @months.each do |m| %>
            <% v = cells[m.beginning_of_month] %>
            <% total += v.to_i %>
            <td><%= v.to_i.positive? ? v : "" %></td>
          <% end %>
          <td><strong><%= total %></strong></td>
        </tr>
      <% end %>
    <% end %>
    <% if @matrix.empty? %>
      <tr><td colspan="15" class="text-muted">本财年暂无计划数据（可在下方添加或导入 Plan.xlsx）</td></tr>
    <% end %>
  </tbody>
</table>

<h5 class="mt-3">明细</h5>
<%= form_tag sales_plans_path(fy: @fy) do %>
<table class="table table-striped table-sm">
  <thead>
    <tr>
      <th>财年</th><th>客户</th><th>大类</th><th>月份</th><th>数量</th><th>芯片额</th><th>软件额</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% @entries.each do |e| %>
      <tr>
        <td>FY<%= e.fy %></td>
        <td><%= e.customer.name %></td>
        <td><%= e.product_group %></td>
        <td><%= e.month.strftime("%Y-%m") %></td>
        <td><%= e.quantity %></td>
        <td><%= e.chip_amount %></td>
        <td><%= e.software_amount %></td>
        <td><%= link_to "✘", sales_plan_path(e, fy: @fy), data: { turbo_method: :delete, turbo_confirm: "删除该条目？" }, class: "btn btn-link text-danger" %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th>FY<%= @fy %></th>
      <th>
        <select name="sales_plan_entry[customer_id]" class="form-select form-select-sm" required>
          <option value="" selected disabled>客户*</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name) %>
        </select>
      </th>
      <th>
        <input name="sales_plan_entry[product_group]" class="form-control form-control-sm" list="plan_groups" placeholder="大类*" required>
        <datalist id="plan_groups"><%= options_for_select(@groups) %></datalist>
      </th>
      <th>
        <select name="sales_plan_entry[month]" class="form-select form-select-sm" required>
          <%= options_for_select(@months.map { |m| [m.strftime("%Y-%m"), m.strftime("%Y-%m-%d")] }) %>
        </select>
      </th>
      <th><input name="sales_plan_entry[quantity]" type="number" min="0" class="form-control form-control-sm" placeholder="数量"></th>
      <th><input name="sales_plan_entry[chip_amount]" type="number" step="any" min="0" class="form-control form-control-sm" placeholder="芯片额"></th>
      <th><input name="sales_plan_entry[software_amount]" type="number" step="any" min="0" class="form-control form-control-sm" placeholder="软件额"></th>
      <th><button type="submit" class="btn btn-sm btn-primary">添加</button></th>
    </tr>
  </tfoot>
</table>
<% end %>

<p>
  <a class="btn btn-primary" data-bs-toggle="collapse" href="#planImport" role="button">导入 Plan.xlsx</a>
</p>
<div class="collapse" id="planImport">
  <div class="card card-body">
    <p class="small text-muted">
      版式：货币段（人民币/美元）→ 大类行（与产品大类一致）→ 客户行（12 个月数字，四月起）。<br>
      24 个数字 = 数量 + 芯片额；36 个 = 数量 + 芯片额 + 软件额。合计行自动跳过；客户名按 名称/全名/中文名 匹配，未匹配项进入导入报告。
    </p>
    <%= form_tag import_sales_plans_path(fy: @fy), multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "导入 FY#{@fy}", class: "btn btn-primary mt-2" %>
    <% end %>
  </div>
</div>
