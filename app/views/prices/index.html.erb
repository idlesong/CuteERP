<%- model_class = Price -%>
<div class="page-header">
  <h1><%= t(:price) %><small>---报价管理</small></h1>
</div>


<%= form_tag prices_path(inline: 1), id: "price-new-form" do end %>
<table class="table table-striped datatable">
  <thead>
    <tr>
      <th><%= t(:price_number) %></th>
      <th>生效日期</th>
      <th>失效日期</th>
      <th><%= t(:customer) %></th>
      <th><%= t(:part_number) %></th>
      <th>总单价</th>
      <th>芯片</th>
      <th>声码1</th>
      <th>声码2</th>
      <th>数量</th>
      <th>ODM/OEM</th>
      <th><%= t(:default_price) %></th>
      <th>PRR</th>
      <th><%= t(:remark) %></th>
      <th><%= t(:status) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @prices.each do |price| %>
      <% if params[:edit_id].to_i == price.id %>
        <tr class="table-warning">
          <%= form_tag price_path(price), method: :patch do %>
            <input type="hidden" name="inline_edit" value="1">
            <td data-order="<%= price.price_number %>"><%= link_to(price.price_number || "—", price_path(price)) %></td>
            <td><input name="price[effective_from]" type="date" value="<%= price.effective_from %>" class="form-control form-control-sm"></td>
            <td><input name="price[expired_at]" type="date" value="<%= price.expired_at %>" class="form-control form-control-sm"></td>
            <td><%= price.customer_name %></td>
            <td><%= price.part_number %></td>
            <td><input name="price[price]" value="<%= price.price %>" class="form-control form-control-sm" placeholder="=50+50 或 单价" required></td>
            <td><%= price.base_price %></td>
            <td><%= price.v1_price %></td>
            <td><%= price.v2_price %></td>
            <td><input name="price[condition]" value="<%= price.condition %>" class="form-control form-control-sm" style="width: 6rem;"></td>
            <td><%= price.customer&.sales_type %></td>
            <td></td>
            <td></td>
            <td><input name="price[remark]" value="<%= price.remark %>" class="form-control form-control-sm"></td>
            <td><%= price.status %></td>
            <td class="text-nowrap">
              <button type="submit" class="btn btn-sm btn-primary">保存</button>
              <%= link_to "取消", prices_path, class: "btn btn-sm btn-outline-secondary" %>
            </td>
          <% end %>
        </tr>
        <% next %>
      <% end %>
      <% currency_unit = price.currency == "USD" ? "$" : "¥" %>
      <% set_price = PriceListEntry.tier_price(price.part_number, price.customer&.sales_type, price.condition) %>
      <tr>
        <td><%= link_to(price.price_number || "—", price_path(price)) %></td>
        <td><%= price.effective_from %></td>
        <td><%= price.expired_at %></td>
        <td>
          <% if price.customer %>
            <%= link_to cust_name(price.customer), price.customer %>
          <% else %>
            <%= price.customer_name %>
          <% end %>
        </td>
        <td><%= price.part_number %></td>
        <td><strong><%= money(price.price, price.currency) %></strong></td>
        <td><%= price.base_price %></td>
        <td><%= price.v1_price %></td>
        <td><%= price.v2_price %></td>
        <td><%= price.condition %></td>
        <td><%= price.customer&.sales_type %></td>
        <td><%= set_price ? money(set_price, price.currency) : "" %></td>
        <td><%= "✂" if price.is_prr == 1 %></td>
        <td><%= price.remark %></td>
        <td>
          <% if price.effective? %>
            <span class="badge bg-success">生效</span>
          <% elsif price.in_valid_window? %>
            <%= link_to "批准", price_path(price, status: "approved"), data: { turbo_method: :patch }, class: "text-primary" %>
          <% else %>
            <span class="badge bg-secondary">失效</span>
          <% end %>
        </td>
        <td><%= link_to "编辑", prices_path(edit_id: price.id), class: "btn btn-link btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th></th>
      <th></th>
      <th></th>
      <th>
        <select name="price[customer_id]" form="price-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>客户*</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name) %>
        </select>
      </th>
      <th>
        <select name="price[part_number]" form="price-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>通用型号*</option>
          <%= options_for_select(Item.where.not(generic_part_no: nil).distinct.order(:generic_part_no).pluck(:generic_part_no)) %>
        </select>
      </th>
      <th><input name="price[price]" form="price-new-form" class="form-control form-control-sm" placeholder="=50+50 或 单价*" required></th>
      <th></th>
      <th></th>
      <th></th>
      <th><select name="price[condition]" id="price_condition" form="price-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>订单量*</option>
          <%= options_for_select(PriceListEntry::TIERS) %>
        </select></th>
      <th><span id="pc_sell_by" class="small text-muted"></span></th>
      <th><span id="pc_tier" class="small text-muted"></span></th>
      <th></th>
      <th></th>
      <th></th>
      <th><button type="submit" form="price-new-form" class="btn btn-sm btn-primary">快速创建</button></th>
    </tr>
  </tfoot>
</table>
<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整字段）", new_price_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 CSV", prices_path(format: "csv"), class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 Excel", prices_path(format: "xls"), class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_prices_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>

<script>
  (function () {
    let timer = null

    function loadInfo() {
      const customer = document.querySelector('select[name="price[customer_id]"]')
      const part = document.querySelector('select[name="price[part_number]"]')
      const cond = document.getElementById("price_condition")
      const sellBy = document.getElementById("pc_sell_by")
      const tier = document.getElementById("pc_tier")
      if (!customer || !part || !cond) return

      const params = new URLSearchParams()
      if (customer.value) params.set("customer_id", customer.value)
      if (part.value) params.set("part_number", part.value)
      if (cond.value) params.set("condition", cond.value)
      if (!params.toString()) { sellBy.textContent = ""; tier.textContent = ""; return }

      fetch("/prices/options?" + params.toString() + "&info=1")
        .then(function (r) { return r.json() })
        .then(function (d) {
          sellBy.textContent = d.sales_type || ""
          if (d.tier) {
            const v = parseFloat(d.tier)
            tier.textContent = "参考阶梯 ¥" + v.toFixed(2).replace(/\.00$/, "")
          } else {
            tier.textContent = ""
          }
        }).catch(function () {})
    }

    function debounced() { clearTimeout(timer); timer = setTimeout(loadInfo, 200) }

    document.addEventListener("change", function (e) {
      const n = (e.target.name || "") + "|" + (e.target.id || "")
      if (n.indexOf("price[customer_id]") >= 0 || n.indexOf("price[part_number]") >= 0 || n.indexOf("price_condition") >= 0) {
        loadInfo()
      }
    })
    document.addEventListener("input", function (e) {
      if (e.target.id === "price_condition") debounced()
    })
  })()
</script>
