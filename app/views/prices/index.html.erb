<%- model_class = Price -%>
<div class="page-header">
  <h1><%= t(:price) %><small>---报价管理</small></h1>
</div>


<%# 行内快速创建：list_* 隐藏字段把服务端筛选 scope 带回 redirect（避免提交后丢失筛选视图） %>
<%= form_tag prices_path(inline: 1), id: "price-new-form" do %>
  <input type="hidden" name="list_status" value="<%= params[:status] %>">
  <input type="hidden" name="list_is_prr" value="<%= params[:is_prr] %>">
<% end %>
<%# 行内快速编辑：form 置于表格外，行内控件以 form= 关联（form 写进 tr 属非法嵌套，
    部分浏览器解析时会把整行/控件移出表格 → 编辑行消失、DataTables 行数错乱） %>
<% if params[:edit_id].present? %>
  <%= form_tag price_path(params[:edit_id].to_i), method: :patch, id: "price-edit-form" do %>
    <input type="hidden" name="inline_edit" value="1">
    <input type="hidden" name="list_status" value="<%= params[:status] %>">
    <input type="hidden" name="list_is_prr" value="<%= params[:is_prr] %>">
  <% end %>
<% end %>
<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th><%= t(:price_number) %></th>
      <th>生效日期</th>
      <th>失效日期</th>
      <th><%= t(:customer) %></th>
      <th><%= t(:part_number) %></th>
      <th>总单价</th>
      <th>芯片</th>
      <th>声码1</th>
      <th>声码2</th>
      <th>数量</th>
      <th>ODM/OEM</th>
      <th><%= t(:default_price) %></th>
      <th>PRR</th>
      <th><%= t(:remark) %></th>
      <th><%= t(:status) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @prices.each do |price| %>
      <% if params[:edit_id].to_i == price.id %>
        <%# 输入单元格内放 visually-hidden 文本锚点：DataTables 筛选/排序读 textContent，
            锚点保证编辑行与普通行同口径——否则恢复的列筛选（状态/日期月份/单价等）
            匹配不到编辑行 → 整行被过滤「消失」 %>
        <% set_price = PriceListEntry.tier_price(price.part_number, price.customer&.sales_type, price.condition) %>
        <tr class="table-warning">
          <td data-order="<%= price.price_number %>"><%= link_to(price.price_number || "—", price_path(price)) %></td>
          <td><span class="visually-hidden"><%= price.effective_from %></span>
              <input form="price-edit-form" name="price[effective_from]" type="date" value="<%= price.effective_from %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= price.expired_at %></span>
              <input form="price-edit-form" name="price[expired_at]" type="date" value="<%= price.expired_at %>" class="form-control form-control-sm"></td>
          <td><%= price.customer ? cust_name(price.customer) : price.customer_name %></td>
          <td><%= price.part_number %></td>
          <td><span class="visually-hidden"><%= money(price.price, price.currency) %></span>
              <input form="price-edit-form" name="price[price]" value="<%= price.price %>" class="form-control form-control-sm" placeholder="=50+50 或 单价" required></td>
          <td><%= price.base_price %></td>
          <td><%= price.v1_price %></td>
          <td><%= price.v2_price %></td>
          <td><span class="visually-hidden"><%= price.condition %></span>
              <input form="price-edit-form" name="price[condition]" value="<%= price.condition %>" class="form-control form-control-sm" style="width: 6rem;"></td>
          <td><%= price.customer&.sales_type %></td>
          <td><%= set_price ? money(set_price, price.currency) : "" %></td>
          <td><%= "✂" if price.is_prr == 1 %></td>
          <td><span class="visually-hidden"><%= price.remark %></span>
              <input form="price-edit-form" name="price[remark]" value="<%= price.remark %>" class="form-control form-control-sm"></td>
          <td>
            <% if price.effective? %>
              <span class="badge bg-success">生效</span>
            <% elsif price.in_valid_window? %>
              <span class="badge bg-warning text-dark">批准</span>
            <% else %>
              <span class="badge bg-secondary">失效</span>
            <% end %>
          </td>
          <td class="text-nowrap">
            <button type="submit" form="price-edit-form" class="btn btn-sm btn-primary">保存</button>
            <%= link_to "取消", prices_path(request.query_parameters.except("edit_id")), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
        <% next %>
      <% end %>
      <% currency_unit = price.currency == "USD" ? "$" : "¥" %>
      <% set_price = PriceListEntry.tier_price(price.part_number, price.customer&.sales_type, price.condition) %>
      <tr>
        <td><%= link_to(price.price_number || "—", price_path(price)) %></td>
        <td><%= price.effective_from %></td>
        <td><%= price.expired_at %></td>
        <td>
          <% if price.customer %>
            <%= link_to cust_name(price.customer), price.customer %>
          <% else %>
            <%= price.customer_name %>
          <% end %>
        </td>
        <td><%= price.part_number %></td>
        <td><strong><%= money(price.price, price.currency) %></strong></td>
        <td><%= price.base_price %></td>
        <td><%= price.v1_price %></td>
        <td><%= price.v2_price %></td>
        <td><%= price.condition %></td>
        <td><%= price.customer&.sales_type %></td>
        <td><%= set_price ? money(set_price, price.currency) : "" %></td>
        <td><%= "✂" if price.is_prr == 1 %></td>
        <%# 备注默认只显示前两字（超长省略号），完整内容悬浮 title 显示；
            visually-hidden 锚点保证列筛选仍按全文匹配 %>
        <td title="<%= price.remark %>"><%= truncate(price.remark.to_s, length: 2, omission: "…") %><span class="visually-hidden"><%= price.remark %></span></td>
        <td>
          <% if price.effective? %>
            <span class="badge bg-success">生效</span>
          <% elsif price.in_valid_window? %>
            <%= link_to "批准", price_path(price, request.query_parameters.merge(status: "approved",
                              list_status: params[:status], list_is_prr: params[:is_prr])),
                        data: { turbo_method: :patch }, class: "text-primary" %>
          <% else %>
            <span class="badge bg-secondary">失效</span>
          <% end %>
        </td>
        <td><%# 编辑链接带当前筛选参数：回到编辑视图时服务端 scope 不丢（客户端筛选由 stateSave 恢复） %>
            <%= link_to "编辑", prices_path(request.query_parameters.merge(edit_id: price.id)), class: "btn btn-link btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th></th>
      <th></th>
      <th></th>
      <th>
        <select name="price[customer_id]" form="price-new-form" class="form-select form-select-sm" required data-searchable>
          <option value="" selected disabled>客户*</option>
          <%= options_from_collection_for_select(Customer.order(:name_zh, :name), :id, ->(c) { cust_name(c) }) %>
        </select>
      </th>
      <th>
        <select name="price[part_number]" form="price-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>通用型号*</option>
          <%= options_for_select(Item.where.not(generic_part_no: nil).distinct.order(:generic_part_no).pluck(:generic_part_no)) %>
        </select>
      </th>
      <th><input name="price[price]" form="price-new-form" class="form-control form-control-sm" placeholder="=50+50 或 单价*" required></th>
      <th></th>
      <th></th>
      <th></th>
      <th><select name="price[condition]" id="price_condition" form="price-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>订单量*</option>
          <%= options_for_select(PriceListEntry::TIERS) %>
        </select></th>
      <th><span id="pc_sell_by" class="small text-muted"></span></th>
      <th><span id="pc_tier" class="small text-muted"></span></th>
      <th></th>
      <th></th>
      <th></th>
      <th><button type="submit" form="price-new-form" class="btn btn-sm btn-primary">快速创建</button></th>
    </tr>
  </tfoot>
</table>
<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整字段）", new_price_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_prices_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>

<script>
  (function () {
    let timer = null

    function loadInfo() {
      const customer = document.querySelector('select[name="price[customer_id]"]')
      const part = document.querySelector('select[name="price[part_number]"]')
      const cond = document.getElementById("price_condition")
      const sellBy = document.getElementById("pc_sell_by")
      const tier = document.getElementById("pc_tier")
      if (!customer || !part || !cond) return

      const params = new URLSearchParams()
      if (customer.value) params.set("customer_id", customer.value)
      if (part.value) params.set("part_number", part.value)
      if (cond.value) params.set("condition", cond.value)
      if (!params.toString()) { sellBy.textContent = ""; tier.textContent = ""; return }

      fetch("/prices/options?" + params.toString() + "&info=1")
        .then(function (r) { return r.json() })
        .then(function (d) {
          sellBy.textContent = d.sales_type || ""
          if (d.tier) {
            const v = parseFloat(d.tier)
            tier.textContent = "参考阶梯 ¥" + v.toFixed(2).replace(/\.00$/, "")
          } else {
            tier.textContent = ""
          }
        }).catch(function () {})
    }

    function debounced() { clearTimeout(timer); timer = setTimeout(loadInfo, 200) }

    document.addEventListener("change", function (e) {
      const n = (e.target.name || "") + "|" + (e.target.id || "")
      if (n.indexOf("price[customer_id]") >= 0 || n.indexOf("price[part_number]") >= 0 || n.indexOf("price_condition") >= 0) {
        loadInfo()
      }
    })
    document.addEventListener("input", function (e) {
      if (e.target.id === "price_condition") debounced()
    })
  })()
</script>
