<%= form_with model: @contact, html: { class: "form-horizontal" } do |f| %>
  <% if @contact.errors.any? %>
    <div id="error_explanation" class="alert alert-danger" role="alert">
      <h2><%= pluralize(@contact.errors.count, "error") %> <%= t(:prohibited_save) %>:</h2>
      <ul>
        <% @contact.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :mobile, class: "form-label" %>
    <%= f.text_field :mobile, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :telephone, class: "form-label" %>
    <%= f.text_field :telephone, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :email, class: "form-label" %>
    <%= f.text_field :email, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :address, class: "form-label" %>
    <%= f.text_field :address, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :note, class: "form-label" %>
    <%= f.text_field :note, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :customer_id, class: "form-label" %>
    <%= f.select :customer_id, options_from_collection_for_select(Customer.all, :id, :name, @contact.customer_id), {}, class: "form-select" %>
  </div>

  <div class="form-actions">
    <%= f.submit nil, class: "btn btn-primary" %>
    <%= link_to t("helpers.links.cancel", default: t("helpers.links.cancel")), contacts_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
