<h1>Listing contacts</h1>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Title</th>
      <th>Mobile</th>
      <th>Telephone</th>
      <th>Email</th>
      <th>Note</th>
      <th>Company</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= inline_edit contact, :name %></td>
        <td><%= contact.title %></td>
        <td><%= contact.mobile %></td>
        <td><%= contact.telephone %></td>
        <td><%= contact.email %></td>
        <td><%= contact.note %></td>
        <td><%= contact.customer&.name %></td>
        <td><%= link_to "Show", contact %></td>
        <td><%= link_to "Edit", edit_contact_path(contact) %></td>
        <td><%= link_to "Destroy", contact, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br />

<%= link_to "New Contact", new_contact_path, class: "btn btn-primary" %>
