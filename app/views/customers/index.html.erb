<%- model_class = Customer -%>
<div class="page-header">
  <h1><%= t(:customer) %></h1>
</div>


<%# 快速创建独立表单：tfoot 控件通过 form= 属性挂接 %>
<%= form_tag customers_path(inline: 1), id: "customer-new-form" do end %>
<%# 行内快速编辑：form 置于表格外，行内控件以 form= 关联（form 写进 tr 属非法嵌套，
    部分浏览器解析时会把整行/控件移出表格 → 编辑行消失、DataTables 行数错乱、快捷编辑往返跳顶） %>
<% if params[:edit_id].present? %>
  <%= form_tag customer_path(params[:edit_id].to_i), method: :patch, id: "customer-edit-form" do %>
    <input type="hidden" name="inline_edit" value="1">
  <% end %>
<% end %>

<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th><%= t(:name) %></th>
      <th>中文名</th>
      <th><%= t(:full_name) %></th>
      <th><%= t(:territory) %></th>
      <th><%= t(:sales_type) %></th>
      <th><%= t(:disty) %></th>
      <th><%= t(:currency) %></th>
      <th><%= t(:actions) %></th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <% if params[:edit_id].to_i == customer.id %>
        <%# 输入单元格内放 visually-hidden 文本锚点：DataTables 筛选/排序读 textContent，
            锚点保证编辑行与普通行同口径——否则恢复的列筛选匹配不到编辑行 → 行被过滤「消失」 %>
        <tr class="table-warning">
          <td data-order="<%= customer.name %>"><span class="visually-hidden"><%= customer.name %></span>
              <input form="customer-edit-form" name="customer[name]" value="<%= customer.name %>" class="form-control form-control-sm" required></td>
          <td><span class="visually-hidden"><%= customer.name_zh %></span>
              <input form="customer-edit-form" name="customer[name_zh]" value="<%= customer.name_zh %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= customer.full_name %></span>
              <input form="customer-edit-form" name="customer[full_name]" value="<%= customer.full_name %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= customer.territory %></span>
              <input form="customer-edit-form" name="customer[territory]" value="<%= customer.territory %>" class="form-control form-control-sm"></td>
          <td><span class="visually-hidden"><%= customer.sales_type %></span>
              <select form="customer-edit-form" name="customer[sales_type]" class="form-select form-select-sm">
                <option value="OEM" <%= "selected" if customer.sales_type == "OEM" %>>OEM</option>
                <option value="ODM" <%= "selected" if customer.sales_type == "ODM" %>>ODM</option>
              </select>
          </td>
          <td><span class="visually-hidden"><%= customer.disty&.name %></span>
              <select form="customer-edit-form" name="customer[disty_id]" class="form-select form-select-sm">
                <option value="" selected>无</option>
                <%= options_from_collection_for_select(Customer.where.not(id: customer.id).order(:name), :id, :name, customer.disty_id) %>
              </select>
          </td>
          <td><span class="visually-hidden"><%= customer.currency %></span>
              <select form="customer-edit-form" name="customer[currency]" class="form-select form-select-sm">
                <option value="RMB" <%= "selected" if customer.currency == "RMB" %>>RMB</option>
                <option value="USD" <%= "selected" if customer.currency == "USD" %>>USD</option>
              </select>
          </td>
          <td class="text-nowrap">
            <button type="submit" form="customer-edit-form" class="btn btn-sm btn-primary">保存</button>
            <%= link_to "取消", customers_path(request.query_parameters.except("edit_id")), class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% else %>
        <tr>
          <td><%= link_to customer.name, customer_path(customer) %></td>
          <td><%= customer.name_zh %></td>
          <td><%= customer.full_name %></td>
          <td><%= customer.territory %></td>
          <td><%= customer.sales_type %></td>
          <td><%= customer.disty&.name %></td>
          <td><%= customer.currency %></td>
          <td><%# 编辑链接带当前 query：回到编辑视图时上下文不丢（客户端筛选由 stateSave 恢复） %>
              <%= link_to "编辑", customers_path(request.query_parameters.merge(edit_id: customer.id)), class: "btn btn-link btn-sm" %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="inline-new-row">
      <th><input name="customer[name]" form="customer-new-form" class="form-control form-control-sm" placeholder="英文名*" required></th>
      <th><input name="customer[name_zh]" form="customer-new-form" class="form-control form-control-sm" placeholder="中文名"></th>
      <th><input name="customer[full_name]" form="customer-new-form" class="form-control form-control-sm" placeholder="公司全称"></th>
      <th><input name="customer[territory]" form="customer-new-form" class="form-control form-control-sm" placeholder="区域"></th>
      <th>
        <select name="customer[sales_type]" form="customer-new-form" class="form-select form-select-sm" required>
          <option value="" selected disabled>销售类型*</option>
          <option value="OEM">OEM</option>
          <option value="ODM">ODM</option>
        </select>
      </th>
      <th>
        <select name="customer[disty_id]" form="customer-new-form" class="form-select form-select-sm">
          <option value="" selected>代理商</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name) %>
        </select>
      </th>
      <th>
        <select name="customer[currency]" form="customer-new-form" class="form-select form-select-sm" required>
          <option value="RMB" selected>RMB</option>
          <option value="USD">USD</option>
        </select>
      </th>
      <th><button type="submit" form="customer-new-form" class="btn btn-sm btn-primary">快速创建</button></th>
    </tr>
  </tfoot>
</table>

<div class="d-flex gap-2 align-items-center flex-wrap mb-2">
  <%= link_to "高级创建（完整字段）", new_customer_path, class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "导出 Excel", customers_path(format: :xlsx), data: { turbo: false }, class: "btn btn-outline-secondary btn-sm" %>
  <%= form_tag import_customers_path, multipart: true, class: "d-flex gap-1 align-items-center" do %>
    <%= file_field_tag :file, class: "form-control form-control-sm", style: "width: 18rem;" %>
    <%= submit_tag "导入", class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
</div>
