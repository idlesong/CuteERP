<%- model_class = Customer -%>
<div class="page-header">
  <h1><%= t(:customer) %></h1>
</div>

<%= form_tag customers_path(inline: 1) do %>
<table class="table table-striped datatable">
  <thead>
    <tr>
      <th><%= model_class.human_attribute_name(:id) %></th>
      <th><%= t(:territory) %></th>
      <th><%= t(:name) %></th>
      <th><%= t(:full_name) %></th>
      <th><%= t(:sales_type) %></th>
      <th><%= t(:disty) %></th>
      <th><%= t(:payment_term) %></th>
      <th><%= t(:currency) %></th>
      <th><%= t(:since) %></th>
      <th><%= t(:credit) %></th>
    </tr>
    <tr class="inline-new-row">
      <th><button type="submit" class="btn btn-sm btn-primary">快速创建</button></th>
      <th></th>
      <th><input name="customer[name]" class="form-control form-control-sm" placeholder="英文名*" required></th>
      <th><input name="customer[full_name]" class="form-control form-control-sm" placeholder="公司全称"></th>
      <th>
        <select name="customer[sales_type]" class="form-select form-select-sm" required>
          <option value="" selected disabled>类型*</option>
          <%= options_for_select(Customer::SALES_TYPES) %>
        </select>
      </th>
      <th></th>
      <th>
        <select name="customer[payment]" class="form-select form-select-sm" required>
          <option value="" selected disabled>付款*</option>
          <%= options_for_select(Order::PAYMENT_TYPES) %>
        </select>
      </th>
      <th>
        <select name="customer[currency]" class="form-select form-select-sm" required>
          <option value="" selected disabled>币别*</option>
          <%= options_for_select(Customer::CURRENCY_TYPES) %>
        </select>
      </th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.id %></td>
        <td><%= customer.territory %></td>
        <td><%= link_to customer.name, customer_path(customer) %></td>
        <td><%= customer.full_name %></td>
        <td><%= customer.sales_type %></td>
        <td><%= customer.disty&.name %></td>
        <td><%= customer.payment %></td>
        <td><%= customer.currency %></td>
        <td><%= customer.since %></td>
        <td><%= customer.credit.to_i %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>

<%= link_to "高级创建（完整字段）", new_customer_path, class: "btn btn-outline-secondary btn-sm" %>

<p>
  <br />
  <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
    Advanced: Export, Import customers
  </a>
</p>
<div class="collapse" id="collapseExample">
  <div class="card card-body">
    <h4>Export Customers:</h4>
    <%= link_to "export csv", customers_path(format: "csv"), class: "btn btn-primary" %>|
    <%= link_to "export Excel", customers_path(format: "xls"), class: "btn btn-primary" %>

    <h4>Import Customers</h4>
    <%= form_tag import_customers_path, multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "Import customers", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<br />
