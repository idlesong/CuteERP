<%- model_class = Customer -%>
<div class="page-header">
  <h1><%= t(:customer) %></h1>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <%= form_with model: Customer.new, url: customers_path, html: { class: "row g-2 align-items-end" } do |f| %>
      <%= f.hidden_field :inline, value: "1" %>
      <div class="col-auto"><%= f.text_field :name, placeholder: "英文名*", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.text_field :full_name, placeholder: "公司全称", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.text_field :name_zh, placeholder: "中文名", class: "form-control form-control-sm" %></div>
      <div class="col-auto"><%= f.select :sales_type, Customer::SALES_TYPES, { prompt: "销售类型*" }, class: "form-select form-select-sm" %></div>
      <div class="col-auto"><%= f.select :payment, Order::PAYMENT_TYPES, { prompt: "付款*" }, class: "form-select form-select-sm" %></div>
      <div class="col-auto"><%= f.select :currency, Customer::CURRENCY_TYPES, { prompt: "币别*" }, class: "form-select form-select-sm" %></div>
      <div class="col-auto"><%= f.submit "快速创建", class: "btn btn-sm btn-primary" %></div>
      <div class="col-auto"><%= link_to "高级创建（完整字段）", new_customer_path, class: "btn btn-sm btn-outline-secondary" %></div>
    <% end %>
  </div>
</div>

<table class="table table-striped datatable">
  <thead>
    <tr>
      <th>id</th>
      <th><%= t(:territory) %></th>
      <th><%= t(:name) %></th>
      <th><%= t(:full_name) %></th>
      <th><%= t(:sales_type) %></th>
      <th><%= t(:disty) %></th>
      <th><%= t(:payment_term) %></th>
      <th><%= t(:currency) %></th>
      <th><%= t(:since) %></th>
      <th><%= t(:credit) %></th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.id %></td>
        <td><%= customer.territory %></td>
        <td><%= link_to customer.name, customer_path(customer) %></td>
        <td><%= customer.full_name %></td>
        <td><%= customer.sales_type %></td>
        <td><%= customer.disty&.name %></td>
        <td><%= customer.payment %></td>
        <td><%= customer.currency %></td>
        <td><%= customer.since %></td>
        <td><%= customer.credit.to_i %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "高级创建（完整字段）", new_customer_path, class: "btn btn-outline-secondary btn-sm" %>

<p>
  <br />
  <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
    Advanced: Export, Import customers
  </a>
</p>
<div class="collapse" id="collapseExample">
  <div class="card card-body">
    <h4>Export Customers:</h4>
    <%= link_to "export csv", customers_path(format: "csv"), class: "btn btn-primary" %>|
    <%= link_to "export Excel", customers_path(format: "xls"), class: "btn btn-primary" %>

    <h4>Import Customers</h4>
    <%= form_tag import_customers_path, multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "Import customers", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<br />
