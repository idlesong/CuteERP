  <p id="notice" class="alert alert-info" role="alert"><= notice %</p>
< end > -->
<h4><%= @customer.full_name %></h4>
<ul class="list-inline">
  <li><%= t(:since) %>:<%= @customer.since %></li>
  <li><%= t(:sales_type) %>:<%= @customer.sales_type %></li>
  <li><%= t(:disty) %>:<%= @customer.disty&.name %></li>
  <li><%= t(:currency) %>:<%= @customer.currency %></li>
  <li><%= t(:payment_term) %>:<%= @customer.payment %></li>
  <li><%= t(:credit) %>:<%= @customer.credit.to_i %></li>
</ul>
<h5><%= t(:territory) %>:<%= @customer.territory %></h5>
<h5><%= t(:bill) %><%= t(:address) %>:<small><%= @customer.address %></small>,
  <%= t(:bill) %><%= t(:contact) %>:<small><%= @customer.contact %></small>,
  <%= t(:telephone) %>:<small><%= @customer.telephone %></small></h5>

<h5><%= t(:ship) %><%= t(:address) %>:<small><%= @customer.ship_address %></small>,
  <%= t(:ship) %><%= t(:contact) %>:<small><%= @customer.ship_contact %></small>,
  <%= t(:ship) %><%= t(:telephone) %>:<small><%= @customer.ship_telephone %></small>
  <%= link_to t(".edit", default: t("helpers.links.edit")), edit_customer_path(@customer) %>

  <%= link_to t(".destroy", default: t("helpers.links.destroy")), customer_path(@customer),
              data: { turbo_method: :delete, turbo_confirm: t(".confirm", default: t("helpers.links.confirm", default: "Are you sure?")) },
              class: "btn btn-danger btn-sm" %></h5>

<h3><%= t(:contact) %>
  <button type="button" class="btn btn-sm btn-primary ajax-new"
    data="<%= @customer.id %>" id="/contacts"><%= t(:new_contact) %></button>
</h3>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th><%= t(:name) %></th>
      <th><%= t(:title) %></th>
      <th><%= t(:mobile) %></th>
      <th><%= t(:telephone) %></th>
      <th><%= t(:email) %></th>
      <th><%= t(:note) %></th>
    </tr>
  </thead>
  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= inline_edit contact, :name %></td>
        <td><%= inline_edit contact, :title %></td>
        <td><%= inline_edit contact, :mobile %></td>
        <td><%= inline_edit contact, :telephone %></td>
        <td><%= inline_edit contact, :email %></td>
        <td><%= inline_edit contact, :note %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h3><%= t(:price) %> <small>(<%= t(:ongoing) %>)</small>

  <%= link_to t(".new", default: t("helpers.links.new")), new_price_path, class: "btn btn-primary" %>
</h3>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>id</th>
      <th>customer</th>
      <th>part_number</th>
      <th>price</th>
      <th>condition</th>
      <th>set_price</th>
      <th>payment_term</th>
      <th>created_at</th>
      <th>status</th>
    </tr>
  </thead>
  <tbody>
    <% @prices.each do |price| %>
      <tr>
        <td><%= link_to price.id, price_path(price) %></td>
        <td><%= price.customer.name %></td>
        <td><%= price.item.partNo %></td>
        <td><strong>¥<%= price.price %></strong></td>
        <td><%= price.condition %></td>
        <td>¥<%= price.get_set_price(price.item_id, price.condition, @customer.sales_type) %></td>
        <td><%= price.payment_terms %></td>
        <td><%= price.created_at.strftime("%F") %></td>
        <td><%= price.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "shared/sales_orders_list" %>

<h3><%= t(:opportunities) %>
  <button type="button" class="btn btn-sm btn-primary ajax-new" data="<%= @customer.id %>" id="/opportunities">new opportunity</button>
</h3>

<% @opportunities.each do |opportunity| %>
  <h4>
    <p class="text-bg-success p-1 d-inline-block w-100">
      Priority:<%= opportunity.priority %> Project type: <strong><%= opportunity.project_type %></strong>
      solution:<strong><%= opportunity.solution %></strong>
      <%= link_to "edit", edit_opportunity_path(opportunity) %>
      <br />
      Note:<%= opportunity.note %>
    </p>
  </h4>
  <table class="table table-striped table-bordered">
    <thead>
      <tr>
        <th>Date</th>
        <th>-</th>
        <th>Status</th>
        <th>Issue</th>
        <th>Todo des</th>
        <th>Todo Status</th>
        <th>Assign</th>
      </tr>
    </thead>
    <tbody>
      <% @oppostatuses.each do |oppostatus| %>
        <% if oppostatus.opportunity_id == opportunity.id %>
          <% keyman = @users.map { |user| [user.id, user.name] } %>
          <tr>
            <td><%= oppostatus.created_at.strftime("%Y/%m/%d") %></td>
            <td><%= inline_edit oppostatus, :status_mark, type: :select, collection: Oppostatus::STATUS_LABEL %></td>
            <td><%= inline_edit oppostatus, :status %></td>
            <td><%= inline_edit oppostatus, :issue %></td>
            <td><%= inline_edit oppostatus, :todo_description %></td>
            <td><%= inline_edit oppostatus, :todo_status, type: :select, collection: Oppostatus::STATUS_FLAG %></td>
            <td><%= inline_edit oppostatus, :user_id, type: :select, collection: keyman %></td>
          </tr>
        <% end %>
      <% end %>
      <tr>
        <td colspan="7">
          <button type="button" class="btn btn-sm btn-primary ajax-new"
            data="<%= opportunity.id %>" data-2="<%= session[:user_id] %>"
            id="/oppostatuses">new oppostatus</button>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>

<br />
