<%= form_with model: @customer, html: { class: "form-horizontal" } do |f| %>
  <% if @customer.errors.any? %>
    <div id="error_explanation" class="alert alert-danger" role="alert">
      <h2><%= pluralize(@customer.errors.count, "error") %> <%= t(:prohibited_save) %>:</h2>
      <ul>
        <% @customer.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-2">
      <%= f.label "#{t(:customer)}#{t(:name)}", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Company *name*" %>
    </div>
    <div class="col-md-2">
      <%= f.label t(:sales_type), class: "form-label" %>
      <%= f.select :sales_type, Customer::SALES_TYPES, {}, class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= f.label t(:disty), class: "form-label" %>
      <% options = @disties ? [["no", 0], options_from_collection_for_select(@disties, :id, :name, @customer.disty_id)] : [["no", 0]] %>
      <%= f.select :disty_id, options_for_select(options), {}, class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= f.label t(:since), class: "form-label" %>
      <%= f.date_select :since, class: "form-select" %>
    </div>
  </div>

  <div><hr></div>
  <div class="row">
    <div class="col-md-2">
      <%= f.label "#{t(:customer)}#{t(:full_name)}", class: "form-label" %>
      <%= f.text_field :full_name, class: "form-control", placeholder: "Company full name" %>
    </div>
    <div class="col-md-2">
      <%= f.label t(:currency), class: "form-label" %>
      <%= f.select :currency, Customer::CURRENCY_TYPES, {}, class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= f.label t(:payment_term), class: "form-label" %>
      <%= f.select :payment, Order::PAYMENT_TYPES, {}, class: "form-select" %>
    </div>
    <div class="col-md-3">
      <%= f.label t(:credit), class: "form-label" %>
      <%= f.text_field :credit, class: "form-control" %>
    </div>
  </div>

  <div><hr></div>
  <div class="row">
    <div class="col-md-2">
      <%= f.label t(:territory), class: "form-label" %>
      <%= f.text_field :territory, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label "#{t(:bill)}#{t(:address)}", class: "form-label" %>
      <%= f.text_area :address, class: "form-control", rows: 4, placeholder: "Please enter address" %>
      <%= f.label "#{t(:bill)}#{t(:contact)}", class: "form-label" %>
      <%= f.text_field :contact, class: "form-control", placeholder: "Please enter contact name" %>
      <%= f.label "#{t(:bill)}#{t(:telephone)}", class: "form-label" %>
      <%= f.text_field :telephone, class: "form-control", placeholder: "0510-6682208" %>
    </div>

    <div class="col-md-4">
      <%= f.label "#{t(:ship)}#{t(:address)}", class: "form-label" %>
      <%= f.text_area :ship_address, class: "form-control", rows: 4, placeholder: "Please enter address" %>
      <%= f.label "#{t(:ship)}#{t(:contact)}", class: "form-label" %>
      <%= f.text_field :ship_contact, class: "form-control", placeholder: "Please enter contact name" %>
      <%= f.label "#{t(:ship)}#{t(:telephone)}", class: "form-label" %>
      <%= f.text_field :ship_telephone, class: "form-control", placeholder: "0510-6682208" %>
    </div>
  </div>

  <div><hr></div>
  <div class="form-actions">
    <p class="text-center">
      <%= f.submit nil, class: "btn btn-primary" %>
      <%= link_to t("helpers.links.cancel", default: t("helpers.links.cancel")), customers_path, class: "btn btn-outline-secondary" %>
    </p>
  </div>
<% end %>
