<div class="page-header"><h1>编辑报价单 <small class="text-muted"><%= @quotation.quotation_number %>（重选价格，已选项预勾选）</small></h1></div>

<%= form_tag quotation_path(@quotation), method: :patch do %>
  <table class="table table-striped table-sm datatable">
    <thead>
      <tr>
        <th>选取</th>
        <th>报价号</th>
        <th>通用型号</th>
        <th>产品</th>
        <th>币别</th>
        <th>总单价</th>
        <th>订单量</th>
        <th>生效日期</th>
        <th>失效日期</th>
        <th>状态</th>
      </tr>
    </thead>
    <tbody>
      <% @prices.each do |price| %>
        <tr>
          <td><%= check_box_tag "price_ids[]", price.id, @selected.include?(price.id), id: "price_#{price.id}" %></td>
          <td><%= price.price_number %></td>
          <td><%= price.part_number %></td>
          <td><%= price.order_item&.name %></td>
          <td><%= price.currency %></td>
          <td class="text-end"><%= money(price.price, price.currency) %></td>
          <td class="text-end"><%= price.condition %></td>
          <td><%= price.effective_from&.to_date %></td>
          <td><%= price.expired_at&.to_date %></td>
          <td><%= price.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="card mb-3">
    <div class="card-body py-2">
      <div class="mb-2">
        <label class="form-label small mb-0">备注</label>
        <input type="text" name="remark" value="<%= @quotation.remark %>" class="form-control form-control-sm">
      </div>
      <button type="submit" class="btn btn-sm btn-primary">保存</button>
      <%= link_to "取消", @quotation, class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>
