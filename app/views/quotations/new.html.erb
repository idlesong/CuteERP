<div class="page-header"><h1>新报价单 <small>---选客户 → 勾选价格 → 生成</small></h1></div>

<div class="card mb-3">
  <div class="card-body py-2">
    <%= form_tag new_quotation_path, method: :get, class: "row g-2 align-items-end" do %>
      <div class="col-auto">
        <label class="form-label small mb-0">客户</label>
        <select name="customer_id" class="form-select form-select-sm" required onchange="this.form.submit()">
          <option value="" disabled <%= "selected" unless @customer %>>选择客户</option>
          <%= options_from_collection_for_select(Customer.order(:name), :id, :name, @customer&.id) %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">载入价格</button>
      </div>
    <% end %>
  </div>
</div>

<% if @customer %>
  <%= form_tag quotations_path do %>
    <%= hidden_field_tag :customer_id, @customer.id %>
    <%= hidden_field_tag :quotation_number, @quotation.quotation_number %>

    <table class="table table-striped table-sm datatable">
      <thead>
        <tr>
          <th>选取</th>
          <th>报价号</th>
          <th>通用型号</th>
          <th>产品</th>
          <th>币别</th>
          <th>总单价</th>
          <th>芯片</th>
          <th>声码1</th>
          <th>声码2</th>
          <th>订单量</th>
          <th>生效日期</th>
          <th>失效日期</th>
          <th>状态</th>
        </tr>
      </thead>
      <tbody>
        <% @prices.each do |price| %>
          <tr>
            <td><%= check_box_tag "price_ids[]", price.id, false, id: "price_#{price.id}" %></td>
            <td><%= price.price_number %></td>
            <td><%= price.part_number %></td>
            <td><%= price.order_item&.name %></td>
            <td><%= price.currency %></td>
            <td class="text-end"><%= money(price.price, price.currency) %></td>
            <td class="text-end"><%= price.base_price %></td>
            <td class="text-end"><%= price.v1_price %></td>
            <td class="text-end"><%= price.v2_price %></td>
            <td class="text-end"><%= price.condition %></td>
            <td><%= price.effective_from&.to_date %></td>
            <td><%= price.expired_at&.to_date %></td>
            <td><%= price.status %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="card mb-3">
      <div class="card-body py-2">
        <div class="mb-2">
          <label class="form-label small mb-0">备注（显示在报价单下方）</label>
          <input type="text" name="remark" class="form-control form-control-sm">
        </div>
        <button type="submit" class="btn btn-sm btn-primary">生成报价单（QT号：<%= @quotation.quotation_number %>）</button>
        <%= link_to "取消", quotations_path, class: "btn btn-sm btn-outline-secondary" %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-muted">请先选择客户载入其价格。</p>
<% end %>
