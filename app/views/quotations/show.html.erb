<% company = current_user.settings(:company) %>
<div class="page-header">
  <h1>客户报价单 <small class="text-muted"><%= @quotation.quotation_number %></small></h1>
</div>

<div class="card mb-3">
  <div class="card-body">
    <div class="row">
      <div class="col">
        <h5><%= company.name_zh %></h5>
        <div class="small text-muted"><%= company.address_zh %></div>
        <div class="small text-muted">Tel: 051066682208</div>
      </div>
      <div class="col text-end">
        <div>日期：<%= @quotation.created_at.strftime("%F") %></div>
        <div>报价单号：<%= @quotation.quotation_number %></div>
        <div>付款方式：<%= @quotation.customer.payment %></div>
      </div>
    </div>
    <hr>
    <div class="row">
      <div class="col">
        <strong>To:</strong>
        <%= @quotation.customer.full_name.presence || @quotation.customer.name %>
      </div>
      <div class="col text-end"><strong>From:</strong> <%= company.name_zh %></div>
    </div>
  </div>
</div>

<table class="table table-striped table-sm">
  <thead>
    <tr>
      <th>#</th>
      <th>型号</th>
      <th>产品名称</th>
      <th>币别</th>
      <th class="text-end">含税单价</th>
      <th class="text-end">订单量 (pcs)</th>
    </tr>
  </thead>
  <tbody>
    <% @quotation.quotation_lines.each_with_index do |line, i| %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= line.part_number %></td>
        <td><%= line.product_name %></td>
        <td><%= line.currency %></td>
        <td class="text-end"><%= money(line.unit_price, line.currency) %></td>
        <td class="text-end"><%= line.condition %></td>
      </tr>
    <% end %>
    <% if @quotation.remark.present? %>
      <tr>
        <td class="fw-bold">备注</td>
        <td colspan="5"><%= @quotation.remark %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-2">
  <%= link_to "编辑", edit_quotation_path(@quotation), class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "打印 PDF", quotation_path(@quotation, format: :pdf), data: { turbo: false }, target: "_blank", class: "btn btn-primary btn-sm" %>
  <%= link_to "删除", @quotation, data: { turbo_method: :delete, turbo_confirm: "删除报价单 #{@quotation.quotation_number}？" }, class: "btn btn-outline-danger btn-sm" %>
  <%= link_to "返回列表", quotations_path, class: "btn btn-link btn-sm" %>
</div>
