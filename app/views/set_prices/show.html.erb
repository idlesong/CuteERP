<%- model_class = SetPrice -%>
<div class="page-header">
  <h1><%= t(:set_price) %></h1>
</div>

<dl class="dl-horizontal">
  <dt><strong>LineNo:</strong></dt>
  <dd><%= @set_price.line_no %></dd>
  <dt><strong>PartNo:</strong></dt>
  <dd><%= @set_price.item.partNo %></dd>
  <dt><strong>sell_by:</strong></dt>
  <dd><%= @set_price.sell_by %></dd>
  <% (1..16).each do |n| %>
    <dt><strong>step<%= n %>:</strong></dt>
    <dd><%= @set_price.public_send("step#{n}") %></dd>
  <% end %>
  <dt><strong>Extra Price:</strong></dt>
  <dd><%= @set_price.extra_price %></dd>
  <dt><strong>released_at:</strong></dt>
  <dd><%= @set_price.released_at %></dd>
</dl>

<%= link_to "Edit", edit_set_price_path(@set_price) %> |
<%= link_to "Back", set_prices_path %>
