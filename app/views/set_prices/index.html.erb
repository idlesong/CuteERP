<%- model_class = SetPrice -%>
<div class="page-header">
  <h1><%= t(:set_price_list) %></h1>
  Set price list released at :
  <%= @latest_released_set_price.released_at.strftime("%F") if @latest_released_set_price %>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <%= form_with model: SetPrice.new, url: set_prices_path, html: { class: "row g-2 align-items-end" } do |f| %>
      <%= f.hidden_field :inline, value: "1" %>
      <div class="col-auto">
        <%= f.collection_select :item_id, Item.all.order(:generic_part_no, :suffix), :id, :partNo, { prompt: "产品*" }, class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto">
        <%= f.select :sell_by, ["OEM", "ODM"], { prompt: "渠道*" }, class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto">
        <%= f.date_field :released_at, value: Date.today, class: "form-control form-control-sm" %>
      </div>
      <div class="col-auto"><%= f.submit "快速建行（后进编辑补阶梯）", class: "btn btn-sm btn-primary" %></div>
    <% end %>
  </div>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th></th>
      <th></th>
      <th colspan="8">OEM</th>
      <th colspan="8">ODM</th>
      <th>Extra</th>
    </tr>
    <tr>
      <th>#</th>
      <th>PartNo</th>
      <% if @step_quantities %>
        <% @step_quantities.each do |volume| %>
          <th><%= volume %></th>
        <% end %>
        <% @step_quantities.each do |volume| %>
          <th><%= volume %></th>
        <% end %>
      <% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if @latest_set_prices %>
      <% @latest_set_prices.each do |set_price| %>
        <tr>
          <td><%= set_price.line_no %></td>
          <td><%= set_price.item.partNo %></td>
          <td><%= set_price.step1 %></td>
          <td><%= set_price.step2 %></td>
          <td><%= set_price.step3 %></td>
          <td><%= set_price.step4 %></td>
          <td><%= set_price.step5 %></td>
          <td><%= set_price.step6 %></td>
          <td><%= set_price.step7 %></td>
          <td><%= set_price.step8 %></td>
          <td><%= set_price.step9 %></td>
          <td><%= set_price.step10 %></td>
          <td><%= set_price.step11 %></td>
          <td><%= set_price.step12 %></td>
          <td><%= set_price.step13 %></td>
          <td><%= set_price.step14 %></td>
          <td><%= set_price.step15 %></td>
          <td><%= set_price.step16 %></td>
          <td><%= set_price.extra_price %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<p>
  <br />
  <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
    Advanced: Export, Import set prices
  </a>
</p>
<div class="collapse" id="collapseExample">
  <div class="card card-body">
    <h4>Export Set Price:</h4>
    <%= link_to "Export CSV", set_prices_path(format: "csv"), class: "btn btn-primary" %> |
    <%= link_to "Export Excel", set_prices_path(format: "xls"), class: "btn btn-primary" %>

    <h4>Import Set Price</h4>
    <%= form_tag import_set_prices_path, multipart: true do %>
      <%= file_field_tag :file, class: "form-control" %>
      <%= submit_tag "Import set price list", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<br />
<br />

<div class="page-header">
  <h1><%= t(:set_price) %></h1>
</div>
<table class="table table-striped datatable">
  <thead>
    <tr>
      <th><%= model_class.human_attribute_name(:id) %></th>
      <th><%= t(:line_no) %></th>
