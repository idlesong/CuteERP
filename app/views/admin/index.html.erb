<div class="page-header d-flex justify-content-between align-items-center">
  <h1>销售总览 <small>---FY<%= @fy %>（<%= @fy - 1 %>-04 ~ <%= @fy %>-03）</small></h1>
  <div class="btn-group">
    <% [SalesPlanEntry.current_fy - 1, SalesPlanEntry.current_fy, SalesPlanEntry.current_fy + 1].each do |y| %>
      <%= link_to "FY#{y}", admin_path(fy: y), class: "btn btn-sm #{y == @fy ? 'btn-primary' : 'btn-outline-secondary'}" %>
    <% end %>
  </div>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabShipped">① 实际出货</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabPlan">② Plan (Budget)</a></li>
  <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabProduct">③ 产品视图</a></li>
</ul>

<div class="tab-content">
  <!-- ① 实际出货：大类 → 客户，对比全年/当月 Plan -->
  <div class="tab-pane fade show active" id="tabShipped">
    <table class="table table-striped table-sm">
      <thead>
        <tr>
          <th>大类</th><th>客户</th>
          <th class="text-end">出库数量</th>
          <th class="text-end">芯片额(¥)</th>
          <th class="text-end">软件额(¥)</th>
          <th class="text-end">合计(¥)</th>
          <th class="text-end">全年Plan</th>
          <th class="text-end">当月Plan</th>
        </tr>
      </thead>
      <tbody>
        <% @shipped.each do |group, customers| %>
          <% group_row = { qty: 0, chip: 0.0, soft: 0.0, total: 0.0 } %>
          <% customers.each do |cname, r| %>
            <% group_row[:qty] += r.qty; group_row[:chip] += r.chip; group_row[:soft] += r.software; group_row[:total] += r.total %>
            <% plan = @plan_lookup.dig(group, cname) || { all_year: 0, this_month: 0 } %>
            <tr>
              <td class="text-muted"><%= group %></td>
              <td><%= cname %></td>
              <td class="text-end"><%= r.qty %></td>
              <td class="text-end"><%= number_with_precision(r.chip, precision: 0) %></td>
              <td class="text-end"><%= number_with_precision(r.software, precision: 0) %></td>
              <td class="text-end"><strong><%= number_with_precision(r.total, precision: 0) %></strong></td>
              <td class="text-end"><%= plan[:all_year].positive? ? plan[:all_year] : "—" %></td>
              <td class="text-end"><%= plan[:this_month].positive? ? plan[:this_month] : "—" %></td>
            </tr>
          <% end %>
          <tr class="table-secondary fw-bold">
            <td colspan="2"><%= group %> 小计</td>
            <td class="text-end"><%= group_row[:qty] %></td>
            <td class="text-end"><%= number_with_precision(group_row[:chip], precision: 0) %></td>
            <td class="text-end"><%= number_with_precision(group_row[:soft], precision: 0) %></td>
            <td class="text-end"><%= number_with_precision(group_row[:total], precision: 0) %></td>
            <td class="text-end">
              <% subtotal_plan = @plan_lookup[group]&.values&.sum { |v| v[:all_year] } %>
              <%= subtotal_plan.to_i.positive? ? subtotal_plan : "—" %>
            </td>
            <td class="text-end">
              <% subtotal_pm = @plan_lookup[group]&.values&.sum { |v| v[:this_month] } %>
              <%= subtotal_pm.to_i.positive? ? subtotal_pm : "—" %>
            </td>
          </tr>
        <% end %>
        <% if @shipped.empty? %>
          <tr><td colspan="8" class="text-muted">FY<%= @fy %> 暂无出货数据</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- ② Plan 视图：货币段 → 大类 → 客户 -->
  <div class="tab-pane fade" id="tabPlan">
    <div class="btn-group mb-2">
      <% { qty: "数量", chip: "芯片额", software: "软件额", total: "总额" }.each do |key, label| %>
        <%= link_to label, admin_path(fy: @fy, metric: key), class: "btn btn-sm #{@metric == AdminController::METRICS[key] ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
    <% rmb_rows = @plan_matrix.reject { |_, cs| cs.keys.all? { |cn| usd_customer?(cn) } } %>
    <% usd_rows = @plan_matrix.select { |_, cs| cs.keys.all? { |cn| usd_customer?(cn) } } %>
    <% { "人民币" => rmb_rows, "美元" => usd_rows }.each do |section, rows| %>
      <h5 class="mt-2"><%= section %>段</h5>
      <table class="table table-striped table-sm">
        <thead>
          <tr>
            <th>大类</th><th>客户</th>
            <% @fy_months.each { |m| %><th><%= m.strftime("%y-%m") %></th><% } %>
            <th>全年</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |group, customers| %>
            <% customers.each do |cname, cells| %>
              <tr>
                <td class="text-muted"><%= group %></td>
                <td><%= cname %></td>
                <% year_total = 0 %>
                <% @fy_months.each do |m| %>
                  <% v = cells[m.beginning_of_month].to_f; year_total += v %>
                  <td class="text-end"><%= v.positive? ? number_with_precision(v, precision: (v % 1).zero? ? 0 : 1) : "" %></td>
                <% end %>
                <td class="text-end fw-bold"><%= number_with_precision(year_total, precision: 0) %></td>
              </tr>
            <% end %>
          <% end %>
          <% if rows.empty? %><tr><td colspan="15" class="text-muted">无数据</td></tr><% end %>
        </tbody>
      </table>
    <% end %>
    <div class="small text-muted">度量口径：数量 = 计划 pcs；芯片额 = base_price 口径；软件额 = v1+v2 口径；美元段按客户币别自动分节（金额单位为原币）。</div>
  </div>

  <!-- ③ 产品视图：family 实际出货 -->
  <div class="tab-pane fade" id="tabProduct">
    <table class="table table-striped table-sm">
      <thead>
        <tr><th>产品族</th><th class="text-end">出库数量</th><th class="text-end">营业额(¥)</th></tr>
      </thead>
      <tbody>
        <% @family.each do |family, r| %>
          <tr>
            <td><%= family %></td>
            <td class="text-end"><%= r.qty %></td>
            <td class="text-end"><strong><%= number_with_precision(r.total, precision: 0) %></strong></td>
          </tr>
        <% end %>
        <% if @family.empty? %>
          <tr><td colspan="3" class="text-muted">FY<%= @fy %> 暂无数据</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<h3 class="mt-4">未签发客户订单 <small><%= link_to(t(:more), orders_path) %></small></h3>
<table class="table table-sm">
  <thead>
    <tr>
      <th>行编号</th><th>客户</th><th>通用型号</th>
      <th class="text-right">净需求</th><th class="text-right">已分配</th><th class="text-right">可分配</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% DemandQuery.allocatable_lines.limit(20).each do |line| %>
      <tr>
        <td><%= link_to line.display_no, order_path(line.order) %></td>
        <td><%= line.order.customer.name %></td>
        <td><%= line.generic_part_no %></td>
        <td class="text-right"><%= line.net_qty %></td>
        <td class="text-right"><%= line.allocated_qty %></td>
        <td class="text-right"><strong><%= line.allocatable_qty %></strong></td>
        <td><%= link_to t(:issue), new_sales_order_path(customer_id: line.order.customer_id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
